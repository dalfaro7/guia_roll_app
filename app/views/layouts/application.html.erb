<!DOCTYPE html>
<html lang="es">

<head>
    <title><%= content_for(:title) || "Programación de Guías" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Programación de Guías">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>


    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"></script>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>



    <% flash.each do |type, message| %>
    <div class="alert alert-<%= type == "notice" ? "success" : "danger" %>">
        <%= message %>
    </div>
    <% end %>
</head>

<body>
    <header class="roll-header">
      <div class="roll-header__identity">
        <strong>Personal de Arenal Rafting</strong>
        <% if user_signed_in? && !content_for?(:work_day_shell) %><span><%= current_user.name %></span><% end %>
      </div>
      <nav class="roll-header__nav" aria-label="Navegación principal">
        <div class="roll-header__links">
          <div class="roll-header__secondary" role="group" aria-label="Administración ocasional">
            <% [["Guías", guides_path], ["Auditoría", audit_logs_path]].each do |label, path| %>
              <%= link_to label, path, class: "roll-header__link", aria: { current: current_page?(path) ? "page" : nil } %>
            <% end %>
            <% if current_user&.admin? || current_user&.recursos_humanos? %>
              <%= link_to "Libres de oficina", office_employee_days_path, class: "roll-header__link", aria: { current: current_page?(office_employee_days_path) ? "page" : nil } %>
            <% end %>
            <% if current_user&.admin? %>
              <%= link_to "Tarifas", compensation_rates_path, class: "roll-header__link" %>
              <%= link_to "Perfiles económicos", compensation_profiles_path, class: "roll-header__link" %>
              <%= link_to "Choferes", drivers_path, class: "roll-header__link" %>
            <% end %>
            <% if current_user&.admin? || current_user&.operador? || current_user&.contabilidad? %>
              <%= link_to "Consolidados", compensation_settlements_path, class: "roll-header__link" %>
              <%= link_to "Tarifario de transporte", transport_rates_path, class: "roll-header__link" %>
            <% end %>
          </div>
          <div class="roll-header__daily" role="group" aria-label="Operación diaria">
            <% daily_links = [["Programación de guías", work_days_path]] %>
            <% if current_user&.admin? || current_user&.operador? || current_user&.contabilidad? %>
              <% daily_links << ["Reportes semanales", guide_assignments_path] %>
            <% end %>
            <% daily_links.concat([["Días libres", day_off_report_path], ["Buses", buses_path], ["Panel de equidad", dashboard_path]]) %>
            <% daily_links.each do |label, path| %>
              <%= link_to label, path, class: "roll-header__link", aria: { current: current_page?(path) ? "page" : nil } %>
            <% end %>
          </div>
          <% if user_signed_in? && !content_for?(:work_day_shell) %>
            <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "roll-header__logout" %>
          <% end %>
        </div>
        <div class="roll-header__app">
          <%= link_to kayaktalkie_login_path, class: "roll-header__kayak", data: { turbo: false } do %>
            <span class="roll-header__badge">nuevo</span>
            <span>KayakTalkie&amp;GPS</span><span aria-hidden="true">↗</span>
          <% end %>
        </div>
      </nav>
    </header>

    <% if controller_name == "work_days" && defined?(@work_day) && @work_day.is_a?(WorkDay) &&
          compensation_correction_required?(@work_day) %>
      <div class="container mt-3" role="group" aria-label="Corrección de una programación cerrada">
        <label for="work-day-correction-reason" class="form-label fw-bold">Motivo de la corrección</label>
        <input id="work-day-correction-reason" type="text" class="form-control"
               placeholder="Explique por qué cambia esta programación cerrada">
        <p class="form-text">Se registrará junto con los cambios de esta programación.</p>
      </div>
      <script>
        document.addEventListener("submit", function(event) {
          const form = event.target;
          if (!form.action.includes("/work_days/<%= @work_day.id %>")) return;
          if (form.querySelector('[name="correction_reason"]')) return;
          const input = document.getElementById("work-day-correction-reason");
          const reason = input.value.trim();
          if (!reason) {
            event.preventDefault();
            input.focus();
            input.setCustomValidity("Indique el motivo de la corrección.");
            input.reportValidity();
            return;
          }
          input.setCustomValidity("");
          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "correction_reason";
          hidden.value = reason;
          form.appendChild(hidden);
        }, true);
        document.addEventListener("input", function(event) {
          if (event.target.id === "work-day-correction-reason") event.target.setCustomValidity("");
        });
      </script>
    <% end %>

    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

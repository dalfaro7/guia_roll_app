<!DOCTYPE html>
<html>

<head>
    <title><%= content_for(:title) || "Programación de Guías" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Programación de Guías">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>


    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"></script>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>



    <% flash.each do |type, message| %>
    <div class="alert alert-<%= type == "notice" ? "success" : "danger" %>">
        <%= message %>
    </div>
    <% end %>
</head>

<body>
    <header class="roll-header">
      <div class="roll-header__identity">
        <strong>Arenal Rafting Staffing</strong>
        <% if user_signed_in? %><span><%= current_user.name %></span><% end %>
      </div>
      <nav class="roll-header__nav" aria-label="Navegación principal">
        <div class="roll-header__links">
          <% [["Programación de guías", work_days_path], ["Asignaciones", guide_assignments_path], ["Guías", guides_path], ["Días libres", day_off_report_path], ["Buses", buses_path], ["Dashboard", dashboard_path], ["Auditoría", audit_logs_path]].each do |label, path| %>
            <%= link_to label, path, class: "roll-header__link", aria: { current: current_page?(path) ? "page" : nil } %>
          <% end %>
          <% if current_user&.admin? || current_user&.recursos_humanos? %>
            <%= link_to "Libres Oficina", office_employee_days_path, class: "roll-header__link", aria: { current: current_page?(office_employee_days_path) ? "page" : nil } %>
          <% end %>
          <% if user_signed_in? %>
            <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "roll-header__logout" %>
          <% end %>
        </div>
        <div class="roll-header__app">
          <%= link_to kayaktalkie_login_path, class: "roll-header__kayak", data: { turbo: false } do %>
            <span class="roll-header__badge">new</span>
            <span>KayakTalkie&amp;GPS</span><span aria-hidden="true">↗</span>
          <% end %>
        </div>
      </nav>
    </header>

    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

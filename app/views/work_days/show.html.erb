<% content_for :title, "Operación del #{l(@work_day.date, format: :long)}" %>
<% content_for :head do %><link rel="stylesheet" href="/work-day.css?v=4"><script src="/work-day-layout.js?v=1" defer></script><script src="/bus-driver.js?v=5" defer></script><% end %>
<% content_for :work_day_shell, "true" %>
<div class="container p-2 work-day-page work-day-three-column">
<div class="day-workspace">
<aside class="day-sidebar day-sidebar-left" aria-label="Menú de la operación">
    <header class="work-day-hero day-sidebar-heading">
      <div><span class="work-day-eyebrow">PROGRAMACIÓN DE GUÍAS</span><h1><%= l(@work_day.date, format: :long) %></h1><p>Organiza el equipo y revisa los detalles de la operación.</p></div>
      <span class="work-day-state"><%= roll_status_label(@work_day.status) %></span>
    </header>
<details class="day-sidebar-disclosure" open><summary class="day-sidebar-toggle">Menú de acciones</summary>
<div class="day-menu-content"><span class="work-day-eyebrow">EN ESTE DÍA</span>
    <nav class="work-day-nav" aria-label="Secciones del día">
      <a href="#day-overview">Resumen</a>
      <% unless @work_day.published? %><a href="#day-transport">Transporte</a><% end %>
      <% if @work_day.draft? %><a href="#day-availability">Disponibilidad</a><% end %>
      <% if @work_day.generated? %><a href="#day-roles">Roles</a><% end %>
      <% if @work_day.published? %><a href="#day-assigned">Equipo y transporte</a><% end %>
      <a href="#day-fairness">Equidad</a>
    </nav>
<span class="work-day-eyebrow">GESTIONAR OPERACIÓN</span>        <div class="work-day-actions d-flex align-items-center gap-2 flex-wrap">

            <% if @work_day.draft? || @work_day.generated? %>
            <%= link_to "Configurar ubicaciones",
                    locations_work_day_path(@work_day),
                    class: "btn btn-outline-primary" %>
            <% end %>

            <% if @work_day.draft? %>
            <%= link_to "Editar requisitos de puestos",
                    edit_slots_work_day_path(@work_day),
                    class: "btn btn-outline-primary" %>
            <% end %>

            <% if @work_day.generated? && (current_user.admin? || current_user.operador?) %>
              <%= link_to "Completar Sara y PM",
                    sara_operation_work_day_path(@work_day),
                    class: "btn btn-outline-primary" %>
            <% end %>

            <% if @work_day.generated? %>
            <%= button_to "Reiniciar programación",
                      reset_roll_work_day_path(@work_day),
                      method: :post,
                      class: "btn btn-secondary",
                      data: {
                        turbo: false,
                        confirm: "¿Reiniciar completamente la programación de este día?"
                      } %>
            <% end %>


            <% if Compensation::EditWindow.applicable?(@work_day) &&
                  (@work_day.generated? || @work_day.published?) &&
                  (current_user.admin? || current_user.operador? || current_user.contabilidad?) %>
              <%= link_to "Ver valoración económica",
                          work_day_compensation_path(@work_day),
                          class: "btn btn-outline-primary" %>
            <% end %>

            <% if @work_day.draft? %>
            <%= button_to "Generar roles",
                      generate_roles_work_day_path(@work_day),
                      method: :patch,
                      class: "btn btn-success",
                      data: {
                        turbo: false,
                        confirm: "¿Generar los roles de este día?"
                      } %>
            <% end %>

            <% if @work_day.generated? %>
            <%= form_with url: publish_work_day_path(@work_day), method: :post,
                  local: true, data: { turbo_confirm: "¿Publicar y enviar esta programación actualizada?" } do %>
              <% if compensation_correction_required?(@work_day) %>
                <%= text_field_tag :correction_reason, nil, class: "form-control mb-2",
                      placeholder: "Motivo de corrección", required: true %>
              <% end %>
              <%= submit_tag "Publicar programación", class: "btn btn-success",
                    disabled: @roll_coverage_errors.present? %>
            <% end %>
            <% end %>

            <% if @work_day.published? %>
            <%= link_to "Distribución de guías y choferes",
                        public_work_day_distribution_path(
                          token: @work_day.signed_id(
                            purpose: :public_distribution, expires_in: 7.days
                          )
                        ),
                        class: "btn btn-outline-primary" %>
            <%= link_to "Reportes del río Balsa",
                        weather_reports_path,
                        class: "btn btn-info" %>


            <%= form_with url: unpublish_work_day_path(@work_day), method: :post,
                  local: true, data: { turbo_confirm: "¿Reabrir esta programación para editar funciones y tareas? Después deberá publicarla nuevamente." } do %>
              <% if compensation_correction_required?(@work_day) %>
                <%= text_field_tag :correction_reason, nil, class: "form-control mb-2",
                      placeholder: "Motivo de corrección", required: true %>
              <% end %>
              <%= submit_tag "Editar operación", class: "btn btn-secondary" %>
            <% end %>
            <% end %>

            <%= link_to "Volver a programación de guías",
                  work_days_path,
                  class: "btn btn-light" %>
        </div>

    <!-- DELETE BUTTON -->
    <details class="work-day-danger"><summary>Acciones de eliminación</summary><p>Eliminar esta programación restaura los saldos. Esta acción no se puede deshacer.</p>
        <%= button_to "Eliminar programación",
                  delete_with_reset_work_day_path(@work_day),
                  method: :delete,
                  class: "btn btn-outline-danger btn-sm",
                  data: {
                    turbo: false,
                    confirm: "Esto eliminará permanentemente la programación y restaurará los saldos. ¿Continuar?"
                  } %>
    </details></div>
<footer class="day-user-footer">
<span class="work-day-eyebrow">SESIÓN ACTUAL</span><strong><%= current_user.name.presence || current_user.email %></strong>
<%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "btn day-logout" %>
</footer></details></aside>
<main class="day-main" aria-label="Área de trabajo">
    <!-- AVAILABILITY -->
    <% if @work_day.draft? %>
    <h2 id="day-availability">Disponibilidad del equipo</h2><p class="work-day-hint">Selecciona el estado de cada guía. Las penalizaciones y tareas asignadas requieren una nota. Guarda al terminar.</p>

    <%= form_with url: update_availability_work_day_path(@work_day),
                  method: :patch do %>

    <%= hidden_field_tag :audit_screen, "work_day_show" %>
    <%= hidden_field_tag :audit_component, "set_availability_form" %>

    <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Guía</th>
                <th>Estado</th>
                <th>Saldo de días libres</th>
            </tr>
        </thead>

        <tbody>
            <% manual_off_guide_ids =
               ManualDayOff
                 .where(date: @work_day.date)
                 .pluck(:guide_id) %>

            <% @guide_days
            .ordered_for_display
            .reject { |gd| manual_off_guide_ids.include?(gd.guide_id) }
            .each_with_index do |gd, index| %>

            <tr>
                <td><%= index + 1 %></td>

                <td>
                    <%= gd.guide.name %>
                </td>

                <td>
                    <%= select_tag "availability[#{gd.id}][status]",
                               options_for_select(
                                 [
                                   ["En espera", "standby"],
                                   ["Día libre", "day_off"],
                                   ["Vacaciones", "vacation"],
                                   ["Penalizado", "penalized"],
                                   ["Tarea asignada", "assigned_task"]
                                 ],
                                 gd.status
                               ),
                               class: "form-select form-select-sm availability-status",
                               data: {
                                 guide_day_id: gd.id
                               } %>

                    <%= text_field_tag "availability[#{gd.id}][status_note]",
                                   gd.status_note,
                                   placeholder: "Obligatorio para penalización o tarea asignada",
                                   class: "form-control form-control-sm mt-1 availability-note",
                                   id: "status_note_#{gd.id}" %>
                </td>

                <% day_off_balance = gd.guide.day_off_balance.to_i %>

                <td class="<%= 'text-danger fw-bold' if day_off_balance.negative? %>">
                    <%= day_off_balance %>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table></div>

    <%= submit_tag "Guardar disponibilidad",
                     class: "btn btn-info" %>
    <% end %>
    <% end %>

    <!-- EDIT ROLES -->
    <% if @work_day.generated? %>
    <% if @roll_coverage_errors.present? %>
    <div class="alert alert-warning" id="day-pending-slots" role="status">
      <strong>Puestos pendientes por cubrir</strong>
      <ul class="mb-1">
        <% @roll_coverage_errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
      Complete las asignaciones antes de publicar la programación.
    </div>
    <% end %>
    <h2 id="day-roles">Roles del equipo</h2><p class="work-day-hint">Compara el rol actual con el nuevo y guarda los cambios antes de publicar.</p>

    <%= form_with url: update_roles_work_day_path(@work_day),
                  method: :patch,
                  local: true, id: "team-roles-form" do %>

    <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Guía</th>
                <th>Rol principal actual</th>
                <th>Nuevo rol principal</th>
                <th>Rol secundario actual</th>
                <th>Nuevo rol secundario</th>
                <th>Tarea de fotos</th>
                <th>Ubicación actual</th>
                <th>Nueva ubicación</th>
            </tr>
        </thead>

        <tbody>
            <% primary_roles = [
               "River Guide",
               "Safety Kayaker",
               "Photographer"
             ] %>

            <% secondary_roles = [
               "Tour Leader",
               "Head Guide",
               "Bus Guide & Towels",
               "Driver"
             ] %>

            <% locations = [
               "Balsa",
               "Sara-3&4",
               "PM",
               "Privado"
             ] %>

            <% location_counters = Hash.new(0) %>

            <% @guide_days
            .counts_as_worked_for_roll
            .ordered_for_display
            .each do |gd| %>

            <% compensation_assignment = @team_compensation_assignments[gd.id] %>
            <% selected_secondary = gd.role_secondary == "Bus Guide, towels & SendPhotos" ? "Bus Guide & Towels" : (gd.role_secondary == "SendPhotos" ? nil : gd.role_secondary) %>
            <% selected_photo_task = compensation_assignment&.photo_task.presence || (gd.role_secondary.to_s.include?("SendPhotos") ? "send_only" : "none") %>
            <tr data-outing="<%= gd.location %>">
                <td>
                    <%= location_counters[
                      gd.location.presence || "NO_LOCATION"
                    ] += 1 %>
                </td>

                <td>
                    <strong><%= gd.guide.name %></strong>
                </td>

                <td>
                    <%= roll_role_label(gd.role_primary) %>
                </td>

                <td class="team-primary-cell">
                    <%= select_tag "roles[#{gd.id}][role_primary]",
                               options_for_select(
                                 primary_roles.map { |role| [roll_role_label(role), role] },
                                 gd.role_primary
                               ),
                               include_blank: true, class: "team-primary-role" %>
                    <span class="team-principal-control" <%= "hidden" unless gd.role_primary == "Photographer" %>>
                        <%= hidden_field_tag "roles[#{gd.id}][principal_photographer]", "0" %>
                        <label><%= check_box_tag "roles[#{gd.id}][principal_photographer]", "1", compensation_assignment&.principal_photographer?, class: "team-principal-checkbox", aria: { label: "Fotógrafo principal: #{gd.guide.name}" } %> Principal</label>
                    </span>
                    <span class="team-send-photos-control" <%= "hidden" unless gd.role_primary == "River Guide" && CompensationAssignment::PHOTO_SENDING_LOCATIONS.include?(gd.location) && !["Tour Leader", "Head Guide"].include?(selected_secondary) %>>
                        <%= hidden_field_tag "roles[#{gd.id}][send_photos]", "0" %>
                        <label><%= check_box_tag "roles[#{gd.id}][send_photos]", "1", selected_photo_task == "send_only", class: "team-send-photos-checkbox", aria: { label: "Envía fotos: #{gd.guide.name}" } %> Envía fotos</label>
                    </span>
                </td>

                <td>
                    <%= roll_role_label(gd.role_secondary) %>
                </td>

                <td>
                    <%= select_tag "roles[#{gd.id}][role_secondary]",
                               options_for_select(
                                 (Departure.leader_rate_suffix_for(gd.location) ? secondary_roles : secondary_roles - ["Tour Leader", "Head Guide"]).map { |role| [roll_role_label(role), role] },
                                 selected_secondary
                               ),
                               include_blank: true %>
                </td>

                <td>
                    <span class="team-photo-task-control" <%= "hidden" if gd.role_primary == "Photographer" || ["Tour Leader", "Head Guide"].include?(selected_secondary) %>>
                        <%= select_tag "roles[#{gd.id}][photo_task]",
                          options_for_select([["Sin tarea de fotos", "none"], ["Toma y envía", "take_and_send"]], selected_photo_task),
                          class: "form-select form-select-sm team-photo-task",
                          aria: { label: "Fotos de #{gd.guide.name}" } %>
                    </span>
                </td>
                <td>
                    <%= gd.location.presence || "-" %>
                </td>

                <td>
                    <%= select_tag "roles[#{gd.id}][location]",
                               options_for_select(
                                 locations,
                                 gd.location
                               ), class: "team-location" %>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table></div>

    <div class="text-center">
        <% if compensation_correction_required?(@work_day) %>
          <%= text_field_tag :correction_reason, nil, class: "form-control mb-2",
                placeholder: "Motivo de corrección", required: true %>
        <% end %>
        <%= submit_tag "Guardar roles",
                       class: "btn btn-primary" %>
    </div>
    <% end %>

    <hr>

    <!-- FORCE GUIDE ASSIGNMENT -->
    <div class="card mt-4">
        <div class="card-header">
            Asignar guía manualmente
        </div>

        <div class="card-body">
            <%= form_with url: force_assign_work_day_path(@work_day),
                      method: :post do %>

            <div class="row">
                <div class="col-md-4">
                    <label>Ubicación</label>

                    <%= select_tag :location,
                             options_for_select(
                               ["Balsa", "Sara-3&4", "Privado", "PM"]
                             ),
                             class: "form-control",
                             id: "force_location" %>
                </div>

                <div class="col-md-4">
                    <label>Habilidades requeridas</label>

                    <%= select_tag "skills[]",
                             options_from_collection_for_select(
                               Skill.all,
                               :id,
                               ->(skill) { roll_skill_label(skill.name) },
                               Skill.find_by(name: "ClassIII")&.id
                             ),
                             multiple: true,
                             class: "form-control",
                             id: "force_skills" %>
                </div>

                <% if compensation_correction_required?(@work_day) %>
                  <div class="col-md-3">
                    <%= text_field_tag :correction_reason, nil, class: "form-control",
                          placeholder: "Motivo de corrección", required: true %>
                  </div>
                <% end %>
                <div class="col-md-3 d-flex align-items-end">
                    <%= submit_tag "Asignar manualmente",
                             class: "btn btn-warning" %>
                </div>
            </div>
            <% end %>

            <div class="mt-3">
                <strong>Próximo guía elegible:</strong>

                <span id="preview_guide">
                    Selecciona habilidades para ver la vista previa
                </span>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const forceSkills = document.getElementById("force_skills");
            const preview = document.getElementById("preview_guide");

            if (!forceSkills || !preview) return;

            function updateGuidePreview() {
                const skills =
                    Array.from(forceSkills.selectedOptions)
                    .map(option => option.value);

                const params = new URLSearchParams();

                skills.forEach(skillId => {
                    if (skillId) {
                        params.append("skills[]", skillId);
                    }
                });

                fetch(
                        "/work_days/<%= @work_day.id %>/preview_force_assign?" +
                        params.toString()
                    )
                    .then(response => response.json())
                    .then(data => {
                        if (data.name) {
                            preview.innerHTML =
                                data.name +
                                " | Prioridad: " + data.priority +
                                " | Días trabajados en el ciclo de equidad: " +
                                data.monthly_worked_days;
                        } else {
                            preview.innerHTML =
                                "Ningún guía en espera cumple los requisitos";
                        }
                    })
                    .catch(error => {
                        console.error("Error de vista previa:", error);

                        preview.innerHTML =
                            "Error al cargar la vista previa";
                    });
            }

            forceSkills.addEventListener(
                "change",
                updateGuidePreview
            );

            updateGuidePreview();
        });
    </script>
    <% end %>

    <!-- PUBLISHED VIEW -->
    <% if @work_day.published? %>
    <h2 id="day-assigned">Equipo y transporte por salida</h2>

    <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-bordered w-100">
        <thead>
            <tr>
                <th>#</th>
                <th>Guía</th>
                <th>Ubicación</th>
                <th>Rol principal</th>
                <th>Rol secundario</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>
            <% location_counters = Hash.new(0) %>

            <%
          special_primary_roles = [
            "Photographer",
            "Safety Kayaker"
          ]

          location_order = {
            "Balsa" => 1,
            "Sara-3&4" => 2,
            "PM" => 3,
            "Privado" => 4
          }

          published_worked_guides =
            RollOutingRoster.new(@work_day)
              .entries
              .sort_by do |guide_day|

                special_role =
                  special_primary_roles.include?(
                    guide_day.role_primary
                  )

                special_role_order =
                  if guide_day.location == "Sara-3&4"
                    0
                  elsif special_role
                    1
                  else
                    0
                  end

                [
                  location_order.fetch(
                    guide_day.location,
                    99
                  ),
                  special_role_order,
                  guide_day.guide.priority || 999,
                  guide_day.guide.name.to_s
                ]
              end
          published_sections = Departure::OPERATING_SECTIONS.map do |section, locations|
            [section, published_worked_guides.select { |guide_day| locations.include?(guide_day.location) }]
          end
          other_guides = published_worked_guides.reject do |guide_day|
            Departure::OPERATING_SECTIONS.values.flatten.include?(guide_day.location)
          end
          published_sections << ["Otros lugares", other_guides] if other_guides.any?
        %>

            <!-- WORKED GUIDES -->
            <% published_sections.each do |section, section_guides| %>
            <tr data-location-section="<%= section %>" class="table-light"><th colspan="6"><%= section == "Sara-3&4" ? "Sarapiquí 3 y 4" : section %></th></tr>
            <% if Departure::OPERATING_SECTIONS.key?(section) && @work_day.passengers_for(section).positive? && section_guides.none? { |guide_day| guide_day.role_primary == "River Guide" } %>
            <tr data-guide-warning="<%= section %>" class="table-warning"><td colspan="6">Hay <%= @work_day.passengers_for(section) %> pasajeros y ningún guía de río asignado a esta salida. Revise la operación.</td></tr>
            <% end %>
            <% section_guides.each do |guide_day| %>
            <tr class="<%= guide_day.location_css_class %>">
                <td>
                    <%
                is_balsa_special_role =
                  guide_day.location == "Balsa" &&
                  special_primary_roles.include?(
                    guide_day.role_primary
                  )
              %>

                    <% unless is_balsa_special_role %>
                    <%= location_counters[
                      guide_day.location.presence || "NO_LOCATION"
                    ] += 1 %>
                    <% end %>
                </td>

                <td>
                    <%= guide_day.guide.name %>
                </td>

                <td>
                    <%= guide_day.location.presence || "-" %>
                </td>

                <td>
                    <%= roll_role_label(guide_day.role_primary) %>
                </td>

                <td>
                    <%= roll_role_label(guide_day.role_secondary) %>
                </td>

                <td>
                    Trabaja
                </td>
            </tr>
            <% end %>
            <% if Departure::OPERATING_SECTIONS.key?(section) %>
            <tr data-transport-location="<%= section %>"><td colspan="6" class="p-2">
              <%= render "buses", work_day: @work_day, location: section, embedded: true %>
            </td></tr>
            <% end %>
            <% end %>

            <!-- STANDBY -->
            <tr class="table-light"><th colspan="6">En espera y otras disponibilidades</th></tr>
            <% @work_day.standby_guides_for_published_roll.each do |guide_day| %>
            <tr>
                <td></td>

                <td>
                    <%= guide_day.guide.name %>
                </td>

                <td>-</td>
                <td>-</td>
                <td>-</td>

                <td>
                    En espera
                </td>
            </tr>
            <% end %>

            <!-- ASSIGNED TASK -->
            <% @work_day.guide_days
          .where(status: :assigned_task)
          .joins(:guide)
          .order(
            "guides.priority ASC",
            "guides.name ASC"
          )
          .each do |guide_day| %>

            <tr>
                <td></td>

                <td>
                    <%= guide_day.guide.name %>
                </td>

                <td>-</td>
                <td>-</td>
                <td>-</td>

                <td>
                    Tarea Asignada

                    <% if guide_day.status_note.present? %>
                    <small class="text-muted d-block">
                        <%= guide_day.status_note %>
                    </small>
                    <% end %>
                </td>
            </tr>
            <% end %>

            <!-- DAY OFF -->
            <% @work_day.guide_days
          .where(status: :day_off)
          .joins(:guide)
          .order(
            "guides.priority ASC",
            "guides.name ASC"
          )
          .each do |guide_day| %>

            <tr>
                <td></td>

                <td>
                    <%= guide_day.guide.name %>
                </td>

                <td>-</td>
                <td>-</td>
                <td>-</td>

                <td>
                    Libre
                </td>
            </tr>
            <% end %>

            <!-- PENALIZED -->
            <% @work_day.guide_days
          .where(status: :penalized)
          .joins(:guide)
          .order(
            "guides.priority ASC",
            "guides.name ASC"
          )
          .each do |guide_day| %>

            <tr>
                <td>
                    <span class="text-danger fw-bold">
                        X
                    </span>
                </td>

                <td>
                    <%= guide_day.guide.name %>
                </td>

                <td>-</td>
                <td>-</td>
                <td>-</td>

                <td>
                    <strong>PENALIZADO</strong>

                    <% if guide_day.status_note.present? %>
                    <small class="text-muted d-block">
                        <%= guide_day.status_note %>
                    </small>
                    <% end %>
                </td>
            </tr>
            <% end %>

            <!-- VACATION -->
            <% @work_day.guide_days
          .where(status: :vacation)
          .joins(:guide)
          .order(
            "guides.priority ASC",
            "guides.name ASC"
          )
          .each do |guide_day| %>

            <tr>
                <td></td>

                <td>
                    <%= guide_day.guide.name %>
                </td>

                <td>-</td>
                <td>-</td>
                <td>-</td>

                <td>
                    Vacaciones
                </td>
            </tr>
            <% end %>

            <!-- MANUAL DAY OFF -->
            <% ManualDayOff
          .includes(:guide)
          .where(date: @work_day.date)
          .joins(:guide)
          .order(
            "guides.priority ASC",
            "guides.name ASC"
          )
          .each do |manual_off| %>

            <tr>
                <td></td>

                <td>
                    <%= manual_off.guide.name %>
                </td>

                <td>-</td>
                <td>-</td>
                <td>-</td>

                <td>
                    LIBRE MANUAL
                </td>
            </tr>
            <% end %>
        </tbody>
    </table></div>

    <!-- BALSA OPERATION SUMMARY -->
    <%
      balsa_passengers =
        (@passenger_counts["Balsa"] || 0).to_i

      actual_balsa_river_guides =
        location_counters["Balsa"].to_i

      recommended_balsa_guides =
        (balsa_passengers / 5.0).ceil

      recommended_rafts =
        recommended_balsa_guides + 2
    %>

    <div class="card mt-4 mb-4">
        <div class="card-header bg-primary text-white">
            <strong>Resumen de Operación Balsa</strong>
        </div>

        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3 mb-3">
                    <h6 class="text-muted">
                        Pasajeros Balsa
                    </h6>

                    <span class="fs-3 fw-bold">
                        <%= balsa_passengers %>
                    </span>
                </div>

                <div class="col-md-3 mb-3">
                    <h6 class="text-muted">
                        Guías de balsa asignados
                    </h6>

                    <span class="fs-3 fw-bold">
                        <%= actual_balsa_river_guides %>
                    </span>
                </div>

                <div class="col-md-3 mb-3">
                    <h6 class="text-muted">
                        Guías recomendados
                    </h6>

                    <span class="fs-3 fw-bold">
                        <%= recommended_balsa_guides %>
                    </span>

                    <small class="text-muted d-block">
                        1 guía por cada 5 pasajeros
                    </small>
                </div>

                <div class="col-md-3 mb-3">
                    <h6 class="text-muted">
                        Número de balsas
                    </h6>

                    <span class="fs-3 fw-bold">
                        <%= recommended_rafts %>
                    </span>

                    <small class="text-muted d-block">
                        Guías recomendados + 2 extras
                    </small>
                </div>
            </div>

            <% guide_difference =
             actual_balsa_river_guides -
             recommended_balsa_guides %>

            <% if guide_difference < 0 %>
            <div class="alert alert-danger mb-0">
                Faltan
                <strong><%= guide_difference.abs %></strong>
                guías de balsa para la operación de Balsa.
            </div>

            <% elsif guide_difference > 0 %>
            <div class="alert alert-warning mb-0">
                Hay
                <strong><%= guide_difference %></strong>
                guías de balsa adicionales sobre la recomendación.
            </div>

            <% else %>
            <div class="alert alert-success mb-0">
                La cantidad de Guías de balsa asignados coincide con la
                recomendación del sistema.
            </div>
            <% end %>
        </div>
    </div>
    <% end %>

    <hr>


        <!-- FAIRNESS DIAGNOSTIC -->
        <div class="container mt-4">
            <details class="card border-secondary" id="day-fairness">
                <summary class="card-header">Diagnóstico de equidad <small>Ver criterios y posición de cada guía</small></summary>

                <div class="card-body">
                    <p class="text-muted mb-3">
                        Esta tabla muestra la posición de equidad de cada guía justo
                        antes de la fecha de operación. El día actual no se
                        incluye en estos cálculos.
                    </p>

                    <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-sm table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Posición</th>
                                <th>Guía</th>
                                <th>Estado</th>
                                <th>Prioridad</th>
                                <th>Equidad desde</th>
                                <th>Días como guía</th>
                                <th>Saldo de entrada</th>
                                <th>Días para la clasificación</th>
                                <th>Días trabajados</th>
                                <th>Consecutivos</th>
                                <th>En espera desde</th>
                            </tr>
                        </thead>

                        <tbody>
                            <%
                fairness_guide_days =
                  @work_day.guide_days
                    .includes(:guide)
                    .select do |guide_day|
                      guide_day.worked? ||
                        guide_day.standby? ||
                        guide_day.assigned_task?
                    end

                # Usa exactamente la misma llave de ranking que utiliza
                # RoleGeneratorV2 y GuideCandidateRanker.
                fairness_guide_days =
                  fairness_guide_days.sort_by do |guide_day|
                    RollFairnessPolicy.ranking_key_for(
                      guide_day.guide,
                      before_date: @work_day.date
                    )
                  end
              %>

                            <% fairness_guide_days.each_with_index do |guide_day, index| %>
                            <%
                  guide = guide_day.guide

                  snapshot =
                    RollFairnessPolicy.fairness_snapshot_for(
                      guide,
                      before_date: @work_day.date
                    )
                %>

                            <tr class="<%= guide.priority == 3 ? 'table-info' : '' %>">
                                <td>
                                    <strong><%= index + 1 %></strong>
                                </td>

                                <td>
                                    <%= guide.name %>
                                </td>

                                <td>
                                    <% if guide_day.worked? %>
                                    <span class="badge bg-success">
                                        Trabajó
                                    </span>

                                    <% elsif guide_day.assigned_task? %>
                                    <span class="badge bg-info text-dark">
                                        Tarea asignada
                                    </span>

                                    <% else %>
                                    <span class="badge bg-secondary">
                                        En espera
                                    </span>
                                    <% end %>
                                </td>

                                <td>
                                    <%= snapshot[:priority] %>
                                </td>

                                <td>
                                    <%= snapshot[:fairness_started_on]&.strftime("%d/%m/%Y") || "-" %>
                                </td>

                                <td>
                                    <strong>
                                        <%= snapshot[:roll_worked_days] %>
                                    </strong>
                                </td>
                                <td>
                                    <%= snapshot[:entry_roll_balance] %>
                                </td>
                                <td>
                                    <strong><%= snapshot[:ranking_roll_days] %></strong>
                                </td>
                                <td>
                                    <%= snapshot[:service_days] %>
                                </td>

                                <td>
                                    <%= snapshot[:consecutive_roll_days] %>
                                </td>

                                <td>
                                    <%= snapshot[:waiting_since]&.strftime("%d/%m/%Y") || "-" %>
                                </td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table></div>

                    <small class="text-muted">
                        Orden de clasificación:
                        Prioridad → Nuevo ingreso → Días para la clasificación → Días consecutivos →
                        Estado del día anterior → En espera desde → Identificador interno.
                        El saldo de entrada aplica durante el mes de activación o el del primer día como guía si ocurre después.
                    </small>
                </div>
            </details>
        </div>

        <!-- TRANSPORTATION -->
        <% unless @work_day.published? %>
        <div class="container mt-4">
            <h2 class="mt-4" id="day-transport">Transporte</h2>

            <div class="row">
                <% ["Balsa", "Sara-3&4", "PM", "Privado"].each do |loc| %>
                <div class="col-md-6 col-lg-3">
                    <%= render "buses",
                       work_day: @work_day,
                       location: loc %>
                </div>
                <% end %>
            </div>
        </div>
        <% end %>

</main>
<aside class="day-sidebar day-sidebar-right" aria-label="Resumen operativo">
<details class="day-sidebar-disclosure" open><summary class="day-sidebar-toggle">Resumen operativo</summary>
        <div class="container mt-1" id="day-overview">
            <div class="row">
                <div class="col work-day-summary">
                  <div class="card"><div class="card-body"><span class="work-day-eyebrow">EQUIPO SOLICITADO</span><strong class="work-day-total"><%= @work_day.guides_requested || 0 %></strong><p>Guías para esta operación</p><small>Revisa la disponibilidad antes de generar los roles.</small></div></div>
                </div>

                <div class="col">
                    <% if @work_day.draft? %>
                    <div class="card">
                        <div class="card-header bg-dark text-white">
                            Viajes
                        </div>

                        <div class="card-body">
                            <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Ubicación</th>
                                        <th>Guías</th>
                                        <th>Pasajeros</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% ["Sara-3&4", "Balsa", "PM", "Privado"].each do |loc| %>
                                    <tr>
                                        <td><%= loc %></td>
                                        <td><%= @location_counts[loc] || 0 %></td>
                                        <td><%= @passenger_counts[loc] || 0 %></td>
                                    </tr>
                                    <% end %>
                                </tbody>
                            </table></div>
                        </div>
                    </div>
                    <% end %>
                </div>

                <div class="col">
                    <!-- NOT AVAILABLE GUIDES -->
                    <div class="card mt-4">
                        <div class="card-header bg-warning text-white">
                            <strong>No disponibles</strong>
                        </div>

                        <div class="card-body">
                            <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Guía</th>
                                        <th>Estado</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% date = @work_day.date %>

                                    <% @work_day.guide_days
                    .includes(:guide)
                    .where(status: [:vacation, :day_off, :assigned_task, :penalized])
                    .joins(:guide)
                    .order("guides.priority ASC")
                    .each do |gd| %>

                                    <tr>
                                        <td>
                                            <strong><%= gd.guide.name %></strong>
                                        </td>

                                        <td>
                                            <% if gd.vacation? %>
                                            <span class="badge bg-danger">Vacaciones</span>

                                            <% elsif gd.day_off? %>
                                            <span class="badge bg-warning text-dark">Día libre</span>

                                            <% elsif gd.assigned_task? %>
                                            <span class="badge bg-info text-dark">Tarea asignada</span>

                                            <small class="text-muted d-block">
                                                <%= gd.status_note %>
                                            </small>

                                            <% elsif gd.penalized? %>
                                            <span class="badge bg-dark">Penalizado</span>

                                            <small class="text-muted d-block">
                                                <%= gd.status_note %>
                                            </small>
                                            <% end %>
                                        </td>

                                        <td>
                                            <% if @work_day.generated? && gd.assigned_task? %>
                                            <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#moveAssignedTaskModal_<%= gd.id %>">
                                                Mover
                                            </button>
                                            <% else %>
                                            -
                                            <% end %>
                                        </td>
                                    </tr>

                                    <% if @work_day.generated? && gd.assigned_task? %>
                                    <div class="modal fade" id="moveAssignedTaskModal_<%= gd.id %>" tabindex="-1" aria-hidden="true">

                                        <div class="modal-dialog">
                                            <div class="modal-content">

                                                <div class="modal-header bg-warning">
                                                    <h5 class="modal-title">
                                                        Mover de tarea asignada a la programación
                                                    </h5>

                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                                                    </button>
                                                </div>

                                                <div class="modal-body">
                                                    <p>
                                                        <strong>Guía:</strong>
                                                        <%= gd.guide.name %>
                                                    </p>

                                                    <p>
                                                        <strong>Estado actual:</strong>
                                                        Tarea Asignada
                                                    </p>

                                                    <% if gd.status_note.present? %>
                                                    <p>
                                                        <strong>Nota:</strong>
                                                        <%= gd.status_note %>
                                                    </p>
                                                    <% end %>

                                                    <%= form_with url: move_assigned_task_to_roll_work_day_path(@work_day),
                                            method: :post,
                                            local: true do %>

                                                    <%= hidden_field_tag :guide_day_id, gd.id %>

                                                    <div class="mb-3">
                                                        <%= label_tag :location, "Ubicación" %>

                                                        <%= select_tag :location,
                                                 options_for_select(
                                                   ["Balsa", "Sara-3&4", "Privado", "PM"]
                                                 ),
                                                 class: "form-select" %>
                                                    </div>

                                                    <div class="text-end">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                            Cancelar
                                                        </button>

                                                        <%= submit_tag "Mover a la programación",
                                                 class: "btn btn-warning",
                                                 data: {
                                                   turbo: false,
                                                   confirm: "Mover #{gd.guide.name} de tarea asignada a la programación?"
                                                 } %>
                                                    </div>
                                                    <% end %>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <% end %>
                                    <% end %>

                                    <% ManualDayOff
                    .includes(:guide)
                    .where(date: date)
                    .joins(:guide)
                    .order("guides.priority ASC")
                    .each do |manual_off| %>

                                    <tr>
                                        <td><%= manual_off.guide.name %></td>

                                        <td>
                                            <span class="badge bg-info text-dark">
                                                Libre manual
                                            </span>
                                        </td>

                                        <td>-</td>
                                    </tr>
                                    <% end %>
                                </tbody>
                            </table></div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <% if @work_day.draft? %>
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            Mayores saldos de días libres <small class="d-block">Solo guías activos · prioridad 2</small>
                        </div>

                        <div class="card-body">
                            <div class="work-day-table-scroll" tabindex="0" role="region" aria-label="Tabla de la operación"><table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Guía</th>
                                        <th>Saldo</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% Guide.active
                      .where(priority: 2)
                      .order(day_off_balance: :desc)
                      .limit(5)
                      .each do |guide| %>

                                    <% balance = guide.day_off_balance.to_i %>

                                    <tr>
                                        <td><%= guide.name %></td>

                                        <td class="<%= 'text-danger fw-bold' if balance.negative? %>">
                                            <%= balance %>
                                        </td>
                                    </tr>
                                    <% end %>
                                </tbody>
                            </table></div>
                        </div>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>

</details></aside>
</div></div>

<script>
    function initializeTeamRoles() {
        const form = document.getElementById("team-roles-form");
        if (!form || form.dataset.teamRolesBound) return;
        form.dataset.teamRolesBound = "true";
        const rows = form.querySelectorAll("tbody tr");
            rows.forEach((row) => {
                const primary = row.querySelector(".team-primary-role");
                const secondary = row.querySelector("select[name$='[role_secondary]']");
                const photoTask = row.querySelector(".team-photo-task");
                const photoTaskControl = row.querySelector(".team-photo-task-control");
                const principal = row.querySelector(".team-principal-control");
                const checkbox = row.querySelector(".team-principal-checkbox");
                const location = row.querySelector(".team-location");
                const sendPhotos = row.querySelector(".team-send-photos-checkbox");
                const sendControl = row.querySelector(".team-send-photos-control");
                const update = () => {
                    row.dataset.outing = location.value;
                    const photographer = primary.value === "Photographer";
                    principal.hidden = !photographer;
                    const headRole = ["Tour Leader", "Head Guide"].includes(secondary.value);
                    const canSend = primary.value === "River Guide" &&
                        ["PM", "Sara-3&4", "Sara-3", "Sara-4"].includes(location.value) && !headRole;
                    sendControl.hidden = !canSend;
                    if (!canSend) sendPhotos.checked = false;
                    photoTaskControl.hidden = photographer || headRole || sendPhotos.checked;
                    photoTask.disabled = photographer || headRole || sendPhotos.checked;
                    if (photographer || headRole || sendPhotos.checked) photoTask.value = "none";
                    if (!photographer) checkbox.checked = false;
                };
                primary.addEventListener("change", update);
                secondary.addEventListener("change", update);
                location.addEventListener("change", update);
                sendPhotos.addEventListener("change", () => {
                    if (sendPhotos.checked) {
                        rows.forEach((other) => {
                            if (other !== row && other.querySelector(".team-location").value === location.value) {
                                other.querySelector(".team-send-photos-checkbox").checked = false;
                                other.querySelector(".team-primary-role").dispatchEvent(new Event("change"));
                            }
                        });
                    }
                    update();
                });
                checkbox.addEventListener("change", () => {
                    if (!checkbox.checked) return;
                    const location = row.querySelector(".team-location").value;
                    rows.forEach((other) => {
                        if (other !== row && other.querySelector(".team-location").value === location) {
                            other.querySelector(".team-principal-checkbox").checked = false;
                        }
                    });
                });
                update();
            });
    }
    document.addEventListener("DOMContentLoaded", initializeTeamRoles);
    document.addEventListener("turbo:load", initializeTeamRoles);
    initializeTeamRoles();
    document.addEventListener("DOMContentLoaded", function() {
        function toggleStatusNote(select) {
            const guideDayId = select.dataset.guideDayId;
            const noteField =
                document.getElementById(`status_note_${guideDayId}`);

            if (!noteField) return;

            const requiresNote = ["penalized", "assigned_task"].includes(
                select.value
            );

            noteField.style.display =
                requiresNote ? "block" : "none";

            if (requiresNote) {
                noteField.setAttribute(
                    "required",
                    "required"
                );
            } else {
                noteField.removeAttribute("required");
                noteField.value = "";
            }
        }

        document
            .querySelectorAll(".availability-status")
            .forEach((select) => {
                toggleStatusNote(select);

                select.addEventListener(
                    "change",
                    function() {
                        toggleStatusNote(select);
                    }
                );
            });
    });
</script>

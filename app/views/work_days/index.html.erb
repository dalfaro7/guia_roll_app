<div class="container text-center">
    <h1>Programación de guías</h1>

    <div class="text-center mb-3">
        <%= link_to "Nueva programación",
              new_work_day_path,
              class: "btn btn-primary" %>
    </div>

    <div class="d-flex justify-content-end align-items-center mb-3">

        <%= link_to "Notas de la programación",
              roll_notes_path,
              class: "btn btn-warning" %>

    </div>

    <%= form_with url: work_days_path, method: :get, local: true do |f| %>
    <div class="row justify-content-center mb-3">
        <div class="col-md-3">
            <%= f.label :start_date, "Desde" %>
            <%= f.date_field :start_date,
                value: params[:start_date],
                class: "form-control" %>
        </div>

        <div class="col-md-3">
            <%= f.label :end_date, "Hasta" %>
            <%= f.date_field :end_date,
                value: params[:end_date],
                class: "form-control" %>
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">
            <%= f.submit "Buscar", class: "btn btn-info" %>
            <%= link_to "Last 7 Days",
                work_days_path,
                class: "btn btn-secondary" %>
        </div>
    </div>
    <% end %>

    <table class="table" border="1" cellpadding="8">
        <tr>
            <th>Fecha</th>
            <th>Guías solicitados</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>

        <% @work_days.each do |day| %>
        <tr>
            <td><%= day.date %></td>
            <td><%= day.guides_requested %></td>
            <td><%= roll_status_label(day.status) %></td>
            <td>
                <div class="btn-group" role="group">
                    <%= link_to "Ver", work_day_path(day), class: "btn btn-info" %>

                    <% if day.draft? %>
                    <%= button_to "Generar",
                            generate_roles_work_day_path(day),
                            method: :patch,
                            class: "btn btn-warning" %>
                    <% end %>

                    <% if day.generated? %>
                    <%= button_to "Publicar",
                            publish_work_day_path(day),
                            method: :post,
                            class: "btn btn-success" %>
                    <% end %>
                </div>
            </td>
        </tr>
        <% end %>
    </table>
</div>
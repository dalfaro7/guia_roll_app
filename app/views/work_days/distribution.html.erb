<% content_for :title, "Distribución de guías y choferes · #{l(@work_day.date, format: :long)}" %>
<% content_for :head do %><link rel="stylesheet" href="/work-day-distribution.css?v=3"><script src="/work-day-distribution.js?v=1" defer></script><% end %>

<main class="container py-4 distribution-page">
  <header class="distribution-heading">
    <div>
      <p class="distribution-eyebrow">PROGRAMACIÓN PUBLICADA</p>
      <h1>Distribución de guías y choferes</h1>
      <p class="distribution-date"><%= l(@work_day.date, format: :long) %></p>
    </div>
    <div class="distribution-header-actions">
      <% unless @public_view %><%= link_to "Volver a la operación", work_day_path(@work_day), class: "btn btn-outline-primary" %><% end %>
      <% share_token = @public_view ? params[:token] : @work_day.signed_id(purpose: :public_distribution, expires_in: 7.days) %>
      <button type="button" class="btn btn-primary" data-copy-distribution="<%= public_work_day_distribution_url(token: share_token) %>">Copiar enlace</button>
      <span class="distribution-copy-status" role="status" aria-live="polite"></span>
    </div>
  </header>

  <p class="distribution-scroll-hint">Desliza horizontalmente para ver todas las columnas.</p>
  <div class="distribution-scroll" role="region" aria-label="Distribución del personal" tabindex="0">
    <table id="distribution-table" class="table table-bordered align-middle">
      <thead>
        <tr>
          <th scope="col">Salida</th>
          <th scope="col">#</th>
          <th scope="col">Guía o chofer</th>
          <th scope="col">Principal</th>
          <th scope="col">Secundario</th>
          <th scope="col">Estado</th>
        </tr>
      </thead>
      <tbody>
        <% @distribution.operating_sections.each do |section| %>
          <% next if section[:rows].empty? %>
          <% guide_number = 0 %>
          <% section[:rows].each_with_index do |row, index| %>
            <tr data-section="<%= section[:label] %>" <% if index.zero? %>data-location-section="<%= section[:label] %>"<% end %> data-person-kind="<%= row[:kind] %>" class="<%= row[:color] %>">
              <% if index.zero? %>
                <th class="distribution-section-cell <%= row[:color] %>" scope="rowgroup" rowspan="<%= section[:rows].size %>" title="<%= section[:label] == "Sara-3&4" ? "Sarapiquí 3 y 4" : section[:label] %>"><span><%= section[:label] == "Sara-3&4" ? "Sara 3/4" : section[:label] %></span></th>
              <% end %>
              <td class="distribution-number"><% if row[:kind] == :guide && !(section[:label] == "Balsa" && ["Photographer", "Safety Kayaker"].include?(row[:primary])) %><%= guide_number += 1 %><% end %></td>
              <td><%= row[:name] %><% if row[:kind] == :driver %><small class="distribution-person-type">Chofer</small><% end %><% if section[:label] == "Otros lugares" || %w[Sara-3 Sara-4].include?(row[:location]) %><small class="distribution-person-type"><%= row[:location] %></small><% end %></td>
              <td><%= roll_role_label(row[:primary]) %></td>
              <td><%= roll_role_label(row[:secondary]) %></td>
              <td><%= row[:status] %><% if row[:note].present? %><small class="distribution-note"><%= row[:note] %></small><% end %></td>
            </tr>
          <% end %>
        <% end %>

        <% @distribution.availability_sections.each do |section| %>
          <% next if section[:rows].empty? %>
          <% section[:rows].each_with_index do |row, index| %>
            <tr data-status-section="<%= section[:label] %>" <% if index.zero? %>data-status-group="<%= section[:label] %>"<% end %> class="distribution-availability">
              <% if index.zero? %><th class="distribution-section-cell distribution-status-cell" scope="rowgroup" rowspan="<%= section[:rows].size %>"><span><%= section[:label] %></span></th><% end %>
              <td class="distribution-number"><%= "×" if section[:label] == "Penalizados" %></td>
              <td><%= row[:name] %></td>
              <td>—</td><td>—</td>
              <td><%= row[:status] %><% if row[:note].present? %><small class="distribution-note"><%= row[:note] %></small><% end %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</main>

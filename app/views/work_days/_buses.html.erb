<section class="card mt-3">
  <div class="card-header bg-secondary text-white"><strong><%= location %></strong></div>
  <div class="card-body">
    <p class="mb-3">Pasajeros: <strong><%= work_day.passengers_for(location) %></strong> · Capacidad: <strong><%= work_day.bus_capacity_for(location) %></strong> · Asientos disponibles: <strong><%= work_day.seats_remaining_for(location) %></strong>
      <% if work_day.seats_remaining_for(location) < 0 %><span class="badge bg-danger">Se necesitan más buses</span><% end %>
    </p>
    <% bus_assignments = work_day.buses_for(location).includes(:bus, :driver).to_a %>
    <% if bus_assignments.any? && (current_user.admin? || current_user.operador? || current_user.contabilidad?) %>
      <details class="mb-2 small">
        <summary>Ver total de transporte</summary>
        <p class="mb-0 mt-1">Total: <strong><%= usd(bus_assignments.sum(&:cost_cents)) %></strong>. Tarifa copiada al asignar cada bus; puede ajustar el importe.</p>
      </details>
    <% end %>
    <% bus_assignments.each do |assignment| %>
      <div class="border rounded p-2 mb-2">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <div><strong><%= assignment.bus.alias %></strong> · <%= assignment.bus.transport_company.name %><br>
            <span class="small text-muted"><%= assignment.seats_assigned %> pasajeros · Chofer: <%= assignment.driver&.name || "Sin asignar" %></span>
          </div>
          <%= button_to "Quitar", bus_assignment_path(assignment), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "¿Quitar este bus de la salida?" } } %>
        </div>
        <% if current_user.admin? || current_user.operador? || current_user.contabilidad? %>
          <details class="mt-2 small">
            <summary>Ver costo de este bus</summary>
            <p class="mt-2 mb-1">Costo: <strong><%= usd(assignment.cost_cents) %></strong></p>
            <% if Compensation::EditWindow.allowed?(user: current_user, work_day: work_day) && (current_user.admin? || current_user.operador?) %>
              <%= form_with model: assignment, class: "row g-2 align-items-end" do |f| %>
                <div class="col-12"><%= f.label :cost_usd, "Costo USD", class: "form-label small" %><%= f.number_field :cost_usd, min: 0, step: 0.01, class: "form-control form-control-sm", required: true %></div>
                <% if current_user.admin? && Compensation::EditWindow.closed?(work_day) %>
                  <div class="col-12"><%= label_tag "correction_reason_#{assignment.id}", "Motivo de corrección", class: "form-label small" %><%= text_field_tag :correction_reason, nil, id: "correction_reason_#{assignment.id}", class: "form-control form-control-sm", required: true %></div>
                <% end %>
                <div class="col-12"><%= f.submit "Guardar costo", class: "btn btn-sm btn-outline-primary" %></div>
              <% end %>
            <% end %>
          </details>
        <% end %>
      </div>
    <% end %>
    <% if @available_buses.any? %>
      <%= form_with model: BusAssignment.new, class: "row g-2 align-items-end", data: { controller: "bus-driver", available_buses_url: available_buses_work_day_path(work_day) } do |f| %>
        <%= f.hidden_field :work_day_id, value: work_day.id %>
        <%= f.hidden_field :location, value: location %>
        <div class="col-md-5"><%= f.label :bus_id, "Bus disponible", class: "form-label" %>
          <%= f.select :bus_id,
            options_for_select(@available_buses.map { |bus| ["#{bus.transport_company.name} · #{bus.alias} (#{bus.capacity} pax)", bus.id, { "data-company-id": bus.transport_company_id }] }),
            {}, class: "form-select", data: { bus_driver_target: "bus", action: "change->bus-driver#filterDrivers" } %>
        </div>
        <div class="col-md-3"><%= f.label :driver_id, "Chofer (opcional)", class: "form-label" %>
          <%= f.select :driver_id,
            options_for_select([["Sin chofer", ""]] + @active_drivers.map { |driver| [driver.name, driver.id, { "data-company-id": driver.transport_company_id }] }),
            {}, class: "form-select", data: { bus_driver_target: "driver" } %>
        </div>
        <div class="col-md-2"><%= f.label :seats_assigned, "Pasajeros", class: "form-label" %><%= f.number_field :seats_assigned, min: 0, class: "form-control", required: true %></div>
        <div class="col-12"><%= f.submit "Agregar bus", class: "btn btn-primary" %></div>
      <% end %>
    <% else %>
      <p class="text-muted mb-0">No quedan buses disponibles para esta fecha.</p>
    <% end %>
  </div>
</section>

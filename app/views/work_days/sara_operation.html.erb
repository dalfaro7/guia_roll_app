<% content_for :title, "Sarapiquí Clase IV y Sarapiquí PM · #{l(@work_day.date, format: :long)}" %>

<main class="sara-shell sara-operation">
  <header class="sara-operation-header">
    <div>
      <p class="text-uppercase text-muted small mb-1">Programación de guías · <strong class="sara-state-label"><%= roll_status_label(@work_day.status) %></strong></p>
      <h1 class="h3 mb-1">Sarapiquí Clase IV y Sarapiquí PM</h1>
      <p class="sara-operation-date"><time datetime="<%= @work_day.date.iso8601 %>"><%= l(@work_day.date, format: :long) %></time></p>
    </div>
    <% unless current_user.hg_sarapiqui? %>
    <div class="d-flex flex-wrap gap-2 align-items-start">
      <%= link_to "Programaciones de Sarapiquí", sara_work_days_path,
            class: "btn btn-outline-primary" %>
      <%= link_to "Guías Freelance", sara_guides_path,
            class: "btn btn-outline-primary" %>
      <% unless current_user.hg_sarapiqui? %>
        <%= link_to "Operación completa", work_day_path(@work_day),
              class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
    <% end %>
  </header>
  <nav class="sara-section-nav" aria-label="Secciones de Sarapiquí Clase IV y Sarapiquí PM">
    <a href="#sara-availability">Disponibilidad</a><a href="#sara-outing-0">Sarapiquí Clase IV</a><a href="#sara-outing-1">Sarapiquí PM</a>
    <% if @work_day.generated? %><a href="#day-extra-sara-guides">Añadir guía</a><% end %>
  </nav>

  <% if @sara_pm_coverage_errors.any? %>
    <div class="alert alert-warning" role="status">
      <strong>Puestos pendientes:</strong>
      <%= @sara_pm_coverage_errors.join(" · ") %>
    </div>
  <% end %>

  <section class="card mb-4" id="sara-availability">
    <div class="card-header"><strong>Disponibilidad · Roll de Sara</strong></div>
    <div class="card-body">
      <% if @work_day.draft? %>
        <p class="text-muted">Guías activos con la habilidad Roll de Sara, de cualquier nivel. Guarda los cambios de cada guía por separado. «Libre» consume saldo y «Penalizado» requiere un motivo; «Disponible» revierte esos estados.</p>
      <% else %>
        <p class="text-muted">La disponibilidad quedó cerrada al generar la programación. Los estados se muestran solo para consulta.</p>
      <% end %>
      <% if @sara_availability_days.any? %>
        <div class="table-responsive">
          <table class="table align-middle sara-responsive-table">
            <thead><tr><th scope="col">Guía</th><th scope="col">Estado actual</th>
              <% if @work_day.draft? %><th scope="col">Cambiar disponibilidad</th><% end %></tr></thead>
            <tbody>
              <% @sara_availability_days.each do |day| %>
                <tr><td data-label="Guía"><strong><%= day.guide.name %></strong><small class="sara-level">Nivel <%= day.guide.priority %></small></td>
                  <td data-label="Estado actual"><%= { "standby" => "Disponible", "day_off" => "Libre",
                    "penalized" => "Penalizado", "worked" => "Asignado",
                    "vacation" => "Vacaciones", "assigned_task" => "Tarea asignada" }
                    .fetch(day.status, day.status) %></td>
                  <% if @work_day.draft? %>
                  <td data-label="Cambiar disponibilidad">
                    <% if day.vacation? || day.assigned_task? %>
                      <span class="text-muted">Se gestiona desde la operación general.</span>
                    <% elsif day.worked? && !%w[Sara-3&4 Sara-3 Sara-4 PM].include?(day.location) %>
                      <span class="text-muted">Asignado fuera de Sarapiquí Clase IV y Sarapiquí PM</span>
                    <% else %>
                      <%= form_with url: update_sara_availability_work_day_path(@work_day),
                            method: :patch, local: true,
                            class: "sara-availability-form",
                            data: { controller: "penalty-reason" }.merge(day.worked? ? { turbo_confirm: "¿Retirar la asignación de #{day.guide.name} y cambiar su disponibilidad?" } : {}) do %>
                        <%= hidden_field_tag :guide_day_id, day.id %>
                        <%= select_tag :status,
                          options_for_select([["Seleccione cambio", ""],
                            ["Disponible", "standby"], ["Libre", "day_off"],
                            ["Penalizado", "penalized"]]),
                          id: "sara_status_#{day.id}", required: true, class: "form-select",
                          data: { penalty_reason_target: "status", action: "change->penalty-reason#update" },
                          aria: { label: "Estado de #{day.guide.name}" } %>
                        <%= text_field_tag :status_note, nil,
                          id: "sara_note_#{day.id}", placeholder: "Motivo de penalización",
                          hidden: true, disabled: true, data: { penalty_reason_target: "note" },
                          class: "form-control",
                          aria: { label: "Motivo de #{day.guide.name}" } %>
                        <%= submit_tag "Guardar", class: "btn btn-sm btn-primary" %>
                      <% end %>
                    <% end %>
                  </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted mb-0">No hay guías activos con la habilidad Roll de Sara registrados para esta fecha.</p>
      <% end %>
    </div>
  </section>

  <% [
    ["Sarapiquí Clase IV", @sara_entries, @sara_required],
    ["Sarapiquí PM", @pm_entries, @pm_required]
  ].each_with_index do |(title, entries, required), index| %>
    <section class="card mb-4" id="sara-outing-<%= index %>">
      <div class="card-header d-flex justify-content-between gap-2">
        <strong><%= title %></strong>
        <span><%= entries.length %> de <%= required %> puestos</span>
      </div>
      <div class="card-body p-0">
        <% if entries.any? %>
          <div class="table-responsive">
            <table class="table align-middle mb-0 sara-responsive-table">
              <thead>
                <tr><th scope="col">Guía</th><th scope="col">Función principal</th><th scope="col">Función secundaria</th></tr>
              </thead>
              <tbody>
                <% entries.each do |entry| %>
                  <tr>
                    <td data-label="Guía">
                      <strong><%= entry.guide.name %></strong>
                      <% if title == "Sarapiquí PM" && @second_outing_guide_ids.include?(entry.guide.id) %>
                        <span class="badge text-bg-info ms-1">Segunda salida</span>
                      <% end %>
                    </td>
                    <td data-label="Función principal"><%= roll_role_label(entry.role_primary) %></td>
                    <td data-label="Función secundaria"><%= entry.role_secondary.present? ? roll_role_label(entry.role_secondary) : "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted p-3 mb-0">Todavía no hay guías asignados.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @work_day.generated? %>
    <%= render "sara_manual_controls" %>
  <% else %>
    <p class="alert alert-info">La programación está en borrador. El operador general configurará los puestos y generará los roles antes de completar Sarapiquí Clase IV y Sarapiquí PM.</p>
  <% end %>
</main>

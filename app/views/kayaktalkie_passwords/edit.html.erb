<h1>Nueva contraseña</h1><% if @error %><p role="alert"><%= @error %></p><% end %><%= form_with url:kayaktalkie_password_path,method: :patch do |f| %><%= f.hidden_field :token,value:@token %><%= f.label :password,'Nueva contraseña' %><%= f.password_field :password,required:true,minlength:12,autocomplete:'new-password' %><%= f.label :password_confirmation,'Confirmar contraseña' %><%= f.password_field :password_confirmation,required:true,minlength:12,autocomplete:'new-password' %><%= f.submit 'Guardar contraseña' %><% end %>

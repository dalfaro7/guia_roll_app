<% content_for :title, "Valoración del #{@work_day.date}" %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
      <h1>Valoración del <%= l(@work_day.date, format: :long) %></h1>
      <p class="text-muted mb-0">Importes de las cuatro salidas de la operación. La programación logística permanece en su vista habitual.</p>
    </div>
    <%= link_to "Volver a la programación", work_day_path(@work_day), class: "btn btn-outline-secondary" %>
  </div>

  <section class="card mb-4">
    <div class="card-body">
      <h2 class="h5">Salidas de la operación</h2>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead><tr><th>Salida</th><th>Actividad</th><th class="text-end">Total</th><th>Detalle</th></tr></thead>
          <tbody>
            <% @operating_sections.each do |location, section_departures| %>
              <% section_assignments = section_departures.flat_map(&:compensation_assignments) %>
              <tr data-operating-section="<%= location %>">
                <th scope="row"><%= location == "Sara-3&4" ? "Sarapiquí 3 y 4" : location %></th>
                <td><%= section_departures.any? ? (section_assignments.one? ? "1 asignación" : "#{section_assignments.size} asignaciones") : "Sin actividad registrada" %></td>
                <td class="text-end"><%= usd(section_assignments.sum(&:total_cents)) %></td>
                <td>
                  <% if section_departures.any? %>
                    <% section_departures.each do |departure| %>
                      <%= link_to(section_departures.one? ? (@can_edit ? "Editar" : "Ver detalle") : "#{@can_edit ? "Editar" : "Ver"} #{departure.label}", "#departure-#{departure.id}", class: "btn btn-sm btn-outline-primary me-1") %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <% if @departures.empty? %>
    <p class="alert alert-info">Aún no hay asignaciones económicas registradas para este día.</p>
  <% else %>
    <% daily_assignments = @departures.flat_map(&:compensation_assignments) %>
    <% daily_totals = daily_assignments.group_by { |assignment| [assignment.guide_id, assignment.driver_id] } %>
    <section class="card mb-4">
      <div class="card-body">
        <h2 class="h5">Total diario por persona</h2>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead><tr><th>Persona</th><th>Salidas activas</th><th class="text-end">Total</th></tr></thead>
            <tbody>
              <% daily_totals.values.sort_by { |assignments| assignments.first.person.name }.each do |assignments| %>
                <tr>
                  <td><%= assignments.first.person.name %></td>
                  <td><%= assignments.count { |assignment| !%w[canceled no_show].include?(assignment.status) } %></td>
                  <td class="text-end fw-bold"><%= usd(assignments.sum(&:total_cents)) %>
                    <% if assignments.any? { |assignment| assignment.pricing_error.present? } %>
                      <span class="text-danger d-block">Pendiente de valorar</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% end %>

  <% @departures.each do |departure| %>
    <% assignments = departure.compensation_assignments.sort_by { |a| [a.person&.name.to_s, a.id] } %>
    <section class="card mb-4" id="departure-<%= departure.id %>">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div><strong><%= departure.label %></strong> · <%= departure.starts_at.in_time_zone("America/Costa_Rica").strftime("%H:%M") %> · <%= departure.status %></div>
        <strong>Total <%= usd(assignments.sum(&:total_cents)) %></strong>
      </div>
      <div class="card-body">
        <% if @can_edit && Compensation::EditWindow.applicable?(@work_day) && departure.status == "scheduled" %>
          <%= link_to "Cancelar salida", confirm_cancel_work_day_departure_path(@work_day, departure),
            class: "btn btn-outline-danger mb-3" %>
        <% end %>

        <div class="table-responsive">
          <table class="table table-sm table-striped align-middle">
            <thead><tr><th>Persona</th><th>Función y tareas</th><th>Estado</th><th>Desglose</th><th class="text-end">Total</th><% if @can_edit %><th>Editar</th><% end %></tr></thead>
            <tbody>
              <% assignments.each do |assignment| %>
                <tr>
                  <td><%= assignment.person&.name %></td>
                  <td><%= compensation_label(assignment.role_code) %><% if assignment.principal_photographer? %> · Fotógrafo principal<% end %></td>
                  <td><%= assignment.status %></td>
                  <td>
                    <% if assignment.pricing_error.present? %><span class="text-danger"><%= assignment.pricing_error %></span><% end %>
                    <% assignment.compensation_lines.each do |line| %>
                      <div><%= compensation_label(line.code) %>: <%= usd(line.amount_cents) %><% if line.discount_percent.positive? %> (segunda salida, descuento <%= line.discount_percent %>%)<% end %></div>
                    <% end %>
                  </td>
                  <td class="text-end fw-bold"><%= usd(assignment.total_cents) %></td>
                  <% if @can_edit %>
                    <td>
                      <details><summary>Modificar</summary>
                        <%= render "compensation_assignments/form", work_day: @work_day, assignment: assignment, return_to: nil %>
                      </details>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @can_edit %>
          <details class="mt-3"><summary>Agregar persona a esta salida</summary>
            <%= form_with url: work_day_compensation_assignments_path(@work_day), method: :post, local: true, class: "row g-2 mt-2" do %>
              <%= hidden_field_tag "compensation_assignment[departure_id]", departure.id %>
              <div class="col-md-4"><%= label_tag "new_guide_#{departure.id}", "Guía" %><%= select_tag "compensation_assignment[guide_id]", options_from_collection_for_select(@guides, :id, :name), include_blank: "Seleccionar si es guía", id: "new_guide_#{departure.id}", class: "form-select" %></div>
              <div class="col-md-4"><%= label_tag "new_driver_#{departure.id}", "Chofer" %><%= select_tag "compensation_assignment[driver_id]", options_from_collection_for_select(@drivers, :id, :name), include_blank: "Seleccionar si es chofer", id: "new_driver_#{departure.id}", class: "form-select" %></div>
              <div class="col-md-4"><%= label_tag "new_role_#{departure.id}", "Función" %><%= select_tag "compensation_assignment[role_code]", options_for_select((compensation_guide_roles_for(departure) + CompensationAssignment::DRIVER_ROLES).map { |code| [compensation_label(code), code] }), id: "new_role_#{departure.id}", class: "form-select" %></div>
              <div class="col-md-4"><%= label_tag "new_photo_#{departure.id}", "Fotos" %><%= select_tag "compensation_assignment[photo_task]", options_for_select([["Sin tarea", "none"], ["Toma y envía", "take_and_send"], ["Solo envía", "send_only"]]), id: "new_photo_#{departure.id}", class: "form-select" %></div>
              <div class="col-md-4"><label class="d-block"><%= check_box_tag "compensation_assignment[also_drives]", "1" %> También conduce</label><label><%= check_box_tag "compensation_assignment[bus_guide]", "1" %> Guía de bus</label></div>
              <% if compensation_correction_required?(@work_day) %><div class="col-md-4"><%= text_field_tag :correction_reason, nil, class: "form-control", placeholder: "Motivo de corrección", required: true %></div><% end %>
              <div class="col-12"><%= submit_tag "Agregar asignación", class: "btn btn-primary" %></div>
            <% end %>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>

</div>

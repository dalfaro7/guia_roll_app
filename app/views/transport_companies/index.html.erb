<main class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div><p class="text-uppercase text-muted small mb-1">Transporte</p><h1>Empresas de transporte</h1></div>
    <%= link_to "Volver a buses", buses_path, class: "btn btn-outline-secondary" %>
  </div>
  <p class="text-muted">Elige qué categorías ofrece cada empresa. Al quitar una, sus vehículos dejan de aparecer en nuevas asignaciones; los viajes ya registrados se conservan.</p>
  <div class="card mb-4"><div class="card-body">
    <h2 class="h5">Agregar empresa</h2>
    <%= form_with model: TransportCompany.new, class: "row g-3 align-items-end" do |f| %>
      <div class="col-md-8"><%= f.label :name, "Nombre", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true, placeholder: "Nombre de la empresa" %></div>
      <fieldset class="col-12">
        <legend class="form-label fs-6 mb-1">Categorías ofrecidas</legend>
        <%= f.collection_check_boxes :vehicle_categories, TransportCompany::VEHICLE_CATEGORY_LABELS.to_a, :first, :last do |choice| %>
          <label class="form-check form-check-inline"><%= choice.check_box(class: "form-check-input") %> <span class="form-check-label"><%= choice.text %></span></label>
        <% end %>
      </fieldset>
      <div class="col-12"><%= f.submit "Agregar", class: "btn btn-primary" %></div>
    <% end %>
  </div></div>
  <% @companies.each do |company| %>
    <section class="card mb-3"><div class="card-body">
      <%= form_with model: company, class: "row g-2 align-items-center mb-3" do |f| %>
        <div class="col-md-7"><%= f.label :name, "Empresa", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
        <div class="col-md-3 pt-md-4"><label><%= f.check_box :internal_fleet %> Flota propia ARC</label></div>
        <fieldset class="col-12">
          <legend class="form-label fs-6 mb-1">Categorías ofrecidas</legend>
          <%= f.collection_check_boxes :vehicle_categories, TransportCompany::VEHICLE_CATEGORY_LABELS.to_a, :first, :last do |choice| %>
            <label class="form-check form-check-inline"><%= choice.check_box(class: "form-check-input") %> <span class="form-check-label"><%= choice.text %></span></label>
          <% end %>
        </fieldset>
        <div class="col-12"><%= f.submit "Guardar", class: "btn btn-outline-primary" %></div>
      <% end %>
      <p class="mb-1"><strong>Vehículos:</strong> <%= company.buses.map(&:alias).join(", ").presence || "Ninguno" %></p>
      <p class="mb-0"><strong>Choferes:</strong> <%= company.drivers.map(&:name).join(", ").presence || "Ninguno" %></p>
    </div></section>
  <% end %>
</main>

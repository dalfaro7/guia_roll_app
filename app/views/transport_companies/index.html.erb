<main class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div><p class="text-uppercase text-muted small mb-1">Transporte</p><h1>Empresas de transporte</h1></div>
    <%= link_to "Volver a buses", buses_path, class: "btn btn-outline-secondary" %>
  </div>
  <div class="card mb-4"><div class="card-body">
    <h2 class="h5">Agregar empresa</h2>
    <%= form_with model: TransportCompany.new, class: "d-flex gap-2" do |f| %>
      <%= f.text_field :name, class: "form-control", required: true, placeholder: "Nombre de la empresa" %>
      <%= f.submit "Agregar", class: "btn btn-primary" %>
    <% end %>
  </div></div>
  <% @companies.each do |company| %>
    <section class="card mb-3"><div class="card-body">
      <%= form_with model: company, class: "row g-2 align-items-center mb-3" do |f| %>
        <div class="col-md-8"><%= f.label :name, "Empresa", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
        <div class="col-md-4 pt-md-4"><%= f.submit "Guardar nombre", class: "btn btn-outline-primary" %></div>
      <% end %>
      <p class="mb-1"><strong>Buses:</strong> <%= company.buses.map(&:alias).join(", ").presence || "Ninguno" %></p>
      <p class="mb-0"><strong>Choferes:</strong> <%= company.drivers.map(&:name).join(", ").presence || "Ninguno" %></p>
    </div></section>
  <% end %>
</main>

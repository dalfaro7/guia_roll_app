<div class="container">
    <h1>Registro de auditoría</h1>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Acción</th>
                <th>Modelo</th>
                <th>Programación</th>
                <th>Guía</th>
                <th>Pantalla</th>
                <th>Componente</th>
                <th>Detalles</th>
            </tr>
        </thead>

        <tbody>
            <% @audit_logs.each do |log| %>
            <tr>
                <td><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td><%= log.user&.name || log.user&.username || "Sistema" %></td>
                <td><%= log.action %></td>
                <td><%= "#{log.auditable_type} ##{log.auditable_id}" %></td>
                <td><%= log.work_day&.date || "-" %></td>
                <td><%= log.metadata&.dig("guide_name") || "-" %></td>
                <td><%= log.metadata&.dig("screen") || "-" %></td>
                <td><%= log.metadata&.dig("component") || "-" %></td>
                <td>
                    <pre style="white-space: pre-wrap;"><%= JSON.pretty_generate(log.metadata || {}) %></pre>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table>
</div>
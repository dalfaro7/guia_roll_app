<% content_for :title, "Guías Freelance · Sara" %>
<main class="sara-shell sara-guides">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h1 class="h3 mb-1">Guías Freelance</h1>
      <p class="text-muted mb-0">Reservas para asignación manual en Sarapiquí Clase IV o PM.</p></div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Programaciones de Sarapiquí", sara_work_days_path, class: "btn btn-outline-primary" %>
      <%= link_to "Agregar guía", new_sara_guide_path, class: "btn btn-primary" %>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table align-middle sara-responsive-table">
      <thead><tr><th scope="col">Guía</th><th scope="col">Estado</th>
        <th scope="col">Habilidades</th><th scope="col">Acciones</th></tr></thead>
      <tbody>
        <% @guides.each do |guide| %>
          <tr><td data-label="Guía"><strong><%= guide.name %></strong></td>
            <td data-label="Estado"><%= guide.active? ? "Activo" : "Inactivo" %></td>
            <td data-label="Habilidades"><%= guide.skills.map { |skill| roll_skill_label(skill.name) }.join(", ") %></td>
            <td data-label="Acciones"><div class="d-flex flex-wrap gap-2">
              <% unless current_user.hg_sarapiqui? %>
                <%= link_to "Editar", edit_sara_guide_path(guide), class: "btn btn-sm btn-outline-primary" %>
              <% end %>
              <%= button_to guide.active? ? "Desactivar" : "Activar",
                toggle_active_sara_guide_path(guide), method: :patch,
                class: "btn btn-sm #{guide.active? ? 'btn-outline-danger' : 'btn-outline-success'}",
                data: { turbo_confirm: "¿Seguro que desea #{guide.active? ? 'desactivar' : 'activar'} a #{guide.name}?" } %>
            </div></td>
          </tr>
        <% end %>
        <% if @guides.empty? %>
          <tr><td colspan="4" class="text-muted">Todavía no hay guías freelance.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>

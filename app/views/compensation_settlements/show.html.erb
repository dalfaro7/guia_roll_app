<div class="container py-4">
  <h1>Consolidado de <%= @settlement.person.name %></h1>
  <p>Del <%= @settlement.week_start.strftime("%d/%m/%Y") %> al <%= @settlement.week_end.strftime("%d/%m/%Y") %> · <%= @settlement.paid? ? "Pagado" : (@settlement.closed_at ? "Pendiente de pago" : "Provisional") %></p>
  <div class="table-responsive"><table class="table table-striped">
    <thead><tr><th>Fecha</th><th>Salida y función</th><th class="text-end">Importe</th></tr></thead>
    <tbody><% @items.each do |item| %>
      <% details = item.details %>
      <tr><td><%= Date.iso8601(details.fetch("date")).strftime("%d/%m/%Y") %></td><td><%= details.fetch("departure") %> · <%= compensation_label(details.fetch("role_code")) %><% details.fetch("lines").each do |line| %><div class="small text-muted"><%= compensation_label(line.fetch("code")) %>: <%= usd(line.fetch("amount_cents")) %></div><% end %></td><td class="text-end"><%= usd(item.amount_cents) %></td></tr>
    <% end %>
    <% @adjustments.each do |adjustment| %><tr><td>Ajuste</td><td><%= adjustment.reason %> · asignación <%= adjustment.source_assignment_id %></td><td class="text-end"><%= usd(adjustment.amount_cents) %></td></tr><% end %>
    </tbody>
    <tfoot><tr><th colspan="2">Total</th><th class="text-end"><%= usd(@settlement.amount_cents) %></th></tr></tfoot>
  </table></div>
  <% if (current_user.admin? || current_user.contabilidad?) && @settlement.closed_at && !@settlement.paid? %>
    <%= button_to "Registrar pago completo", mark_paid_compensation_settlement_path(@settlement), method: :post, class: "btn btn-success", data: { turbo_confirm: "Confirme que el pago completo ya se efectuó." } %>
  <% end %>
  <%= link_to "Volver al consolidado", compensation_settlements_path(week_start: @settlement.week_start), class: "btn btn-outline-secondary mt-3" %>
</div>

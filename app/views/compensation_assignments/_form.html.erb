<%= form_with url: work_day_compensation_assignment_path(work_day, assignment), method: :patch, local: true, class: "d-grid gap-2 mt-2" do %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <% role_codes = assignment.guide? ? compensation_guide_roles_for(assignment.departure) : CompensationAssignment::DRIVER_ROLES %>
  <% incompatible_role = !role_codes.include?(assignment.role_code) %>
  <% role_codes = [assignment.role_code] + role_codes if incompatible_role %>
  <%= select_tag "compensation_assignment[role_code]", options_for_select(role_codes.map { |code| [incompatible_role && code == assignment.role_code ? "Revisar: #{compensation_label(code)} no corresponde a esta salida" : compensation_label(code), code] }, assignment.role_code), class: "form-select form-select-sm", aria: { label: "Función de #{assignment.person.name}" } %>
  <% if incompatible_role %><span class="text-danger">Selecciona una función válida para esta salida antes de guardar.</span><% end %>
  <% if assignment.guide? %>
    <% photo_options = [["Sin tarea de fotos", "none"], ["Toma y envía", "take_and_send"]] %>
    <% photo_options << ["Solo envía", "send_only"] if CompensationAssignment::PHOTO_SENDING_LOCATIONS.include?(assignment.departure.location) %>
    <%= select_tag "compensation_assignment[photo_task]", options_for_select(photo_options, assignment.photo_task), class: "form-select form-select-sm", aria: { label: "Tarea de fotos de #{assignment.person.name}" } %>
    <label><%= hidden_field_tag "compensation_assignment[also_drives]", "0" %><%= check_box_tag "compensation_assignment[also_drives]", "1", assignment.also_drives? %> También conduce</label>
    <label><%= hidden_field_tag "compensation_assignment[bus_guide]", "0" %><%= check_box_tag "compensation_assignment[bus_guide]", "1", assignment.bus_guide? %> Guía de bus</label>
    <label><%= hidden_field_tag "compensation_assignment[principal_photographer]", "0" %><%= check_box_tag "compensation_assignment[principal_photographer]", "1", assignment.principal_photographer? %> Fotógrafo principal</label>
  <% end %>
  <% if compensation_correction_required?(work_day) %><%= text_field_tag :correction_reason, nil, class: "form-control form-control-sm", placeholder: "Motivo de corrección", required: true %><% end %>
  <%= submit_tag "Guardar función y tareas", class: "btn btn-primary btn-sm" %>
<% end %>

<%= form_with url: work_day_compensation_assignment_path(work_day, assignment), method: :patch, local: true, class: "d-grid gap-2 mt-3 border-top pt-3" do %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <%= hidden_field_tag :status_action, "change" %>
  <strong>Cambiar estado</strong>
  <span>Estado actual: <%= compensation_status_label(assignment.status) %></span>
  <%= select_tag "compensation_assignment[status]", options_for_select([["Programada", "planned"], ["Realizada", "performed"], ["Cancelada", "canceled"], ["No se presentó", "no_show"]]), include_blank: "Seleccionar nuevo estado", required: true, class: "form-select form-select-sm", aria: { label: "Nuevo estado de #{assignment.person.name}" } %>
  <label><%= check_box_tag :confirm_status_change, "1", false, required: true %> Confirmo el cambio de estado de <%= assignment.person.name %></label>
  <% if compensation_correction_required?(work_day) %><%= text_field_tag :correction_reason, nil, class: "form-control form-control-sm", placeholder: "Motivo de corrección", required: true %><% end %>
  <%= submit_tag "Aplicar cambio de estado", class: "btn btn-outline-warning btn-sm" %>
<% end %>

<div class="container p-3">
    <div class="card p-4">
        <h3 class="mb-4">New Guide</h3>

        <%= form_with model: @guide do |f| %>
        <div class="mb-3">
            <%= f.label :name, class: "form-label" %>

            <%= f.text_field :name,
                         class: "form-control",
                         required: true %>
        </div>

        <div class="mb-3">
            <%= f.label :priority, class: "form-label" %>

            <%= f.number_field :priority,
                           class: "form-control",
                           required: true %>
        </div>

        <div class="mb-3">
            <label class="form-label">Skills</label>

            <div class="border rounded p-3">
                <%= collection_check_boxes(
                :guide,
                :skill_ids,
                Skill.order(:name),
                :id,
                :name
              ) do |skill| %>

                <div class="form-check mb-1">
                    <%= skill.check_box class: "form-check-input" %>

                    <%= skill.label class: "form-check-label" %>
                </div>

                <% end %>
            </div>
        </div>

        <%#
        El guía se crea sin controlar el estado active desde este formulario.

        La activación se realiza posteriormente desde Guides,
        usando el botón Activate.

        Esa acción inicia formalmente el nuevo ciclo de fairness.
      %>

        <div class="d-flex gap-2">
            <%= f.submit "Create Guide",
                     class: "btn btn-primary" %>

            <%= link_to "Back",
                    guides_path,
                    class: "btn btn-secondary" %>
        </div>
        <% end %>
    </div>
</div>
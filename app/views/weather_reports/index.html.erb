<div class="container py-4 weather-reports-page">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-muted fw-semibold small mb-1">Operaciones de rafting</p>
      <h1 class="h2 mb-1">Reportes de la cuenca del río Balsa</h1>
      <p class="text-muted mb-0">
        Se muestran los dos informes más recientes recibidos de la tarea programada.
      </p>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <%= link_to "Ver fuente en ChatGPT",
                  "https://chatgpt.com/share/6ac9730e-a600-83e8-a6bd-b0e7401705d9",
                  class: "btn btn-outline-primary",
                  target: "_blank",
                  rel: "noopener noreferrer" %>
      <%= link_to "Volver a programación de guías", work_days_path, class: "btn btn-dark" %>
    </div>
  </div>

  <% if @weather_reports.empty? %>
    <div class="alert alert-info shadow-sm" role="status">
      Aún no se ha recibido ningún reporte. Esta pantalla se actualizará cuando llegue la próxima sincronización automática.
    </div>
  <% else %>
    <div class="row g-4">
      <% @weather_reports.each_with_index do |report, index| %>
        <div class="col-12">
          <article class="card shadow-sm border-0 weather-report-card" data-weather-report-id="<%= report.id %>">
            <div class="card-header bg-white border-bottom p-3 p-md-4">
              <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>
                  <span class="badge text-bg-primary mb-2">
                    <%= index.zero? ? "Más reciente" : "Reporte anterior" %>
                  </span>
                  <h2 class="h4 mb-0"><%= report.title %></h2>
                </div>
                <div class="text-md-end text-muted small">
                  <div><strong>Fecha del informe</strong></div>
                  <time datetime="<%= report.reported_at.iso8601 %>">
                    <%= report.reported_at.in_time_zone("Central America").strftime("%d/%m/%Y · %I:%M %p") %>
                  </time>
                </div>
              </div>
            </div>

            <div class="card-body p-3 p-md-4">
              <div class="weather-report-content"><%= simple_format(h(report.body)) %></div>
            </div>

            <div class="card-footer bg-light text-muted small px-3 px-md-4 py-3">
              Fuente: <%= report.source_name %> ·
              <%= link_to "Abrir reporte de origen",
                          report.source_url,
                          target: "_blank",
                          rel: "noopener noreferrer" %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<style>
  .weather-reports-page {
    max-width: 1050px;
  }

  .weather-report-card {
    overflow: hidden;
  }

  .weather-report-content {
    color: #24313d;
    font-size: 1rem;
    line-height: 1.65;
  }

  .weather-report-content p:last-child {
    margin-bottom: 0;
  }
</style>

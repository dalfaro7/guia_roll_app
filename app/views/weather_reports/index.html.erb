<div class="container py-4 weather-reports-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted fw-semibold small mb-1">Operaciones de rafting</p>
            <h1 class="h2 mb-1">Reporte de la cuenca del río Balsa</h1>
            <p class="text-muted mb-0">Se muestra únicamente el informe más reciente disponible.</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <%= link_to "Estación Balsa",
                  "https://www.imn.ac.cr/especial/estacionBalsa.html",
                  class: "btn btn-outline-primary",
                  target: "_blank", rel: "noopener noreferrer" %>
            <%= link_to "Estación Villa Blanca",
                  "https://www.imn.ac.cr/especial/estacionVblanca.html",
                  class: "btn btn-outline-primary",
                  target: "_blank", rel: "noopener noreferrer" %>
            <%= link_to "Volver a programación de guías", work_days_path, class: "btn btn-dark" %>
        </div>
    </div>

    <% report = @weather_reports.first %>
    <% if report.nil? %>
    <div class="alert alert-info shadow-sm" role="status">
        Aún no se ha recibido ningún reporte.
    </div>
    <% else %>
    <article class="card shadow-sm border-0 weather-report-card" data-weather-report-id="<%= report.id %>">
        <div class="card-header bg-white border-bottom p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
                <div>
                    <span class="badge text-bg-primary mb-2">Informe más reciente</span>
                    <h2 class="h4 mb-0"><%= report.title %></h2>
                </div>
                <div class="text-md-end text-muted small">
                    <div><strong>Fecha del informe</strong></div>
                    <time datetime="<%= report.reported_at.iso8601 %>">
                        <%= report.reported_at.in_time_zone("Central America").strftime("%d/%m/%Y · %I:%M %p") %>
                    </time>
                    <div>Hora de Costa Rica</div>
                </div>
            </div>
        </div>

        <div class="card-body p-3 p-md-4">
            <div class="balsa-aviso">
                <strong>Antes de operar</strong>
                <p>Este informe no sustituye la inspección física ni el criterio del responsable operativo.</p>
            </div>

            <div class="balsa-lectura" aria-label="Contenido del informe">
                <% paragraphs = report.body.to_s.strip.split(/\r?\n[ \t]*\r?\n+/).reject(&:blank?) %>
                <% if paragraphs.empty? %>
                <p class="text-muted">El informe no contiene información disponible.</p>
                <% else %>
                <% paragraphs.each do |paragraph| %>
                <div class="balsa-bloque">
                    <%= simple_format(h(paragraph)) %>
                </div>
                <% end %>
                <% end %>
            </div>
        </div>

        <div class="card-footer bg-light text-muted small px-3 px-md-4 py-3">
            Fuente registrada: <%= report.source_name %> ·
            <%= link_to "Abrir fuente del informe", report.source_url,
                    target: "_blank", rel: "noopener noreferrer" %>
        </div>
    </article>
    <% end %>
</div>

<style>
    .weather-reports-page {
        max-width: 1050px;
    }

    .weather-report-card {
        overflow: hidden;
    }

    .balsa-aviso {
        padding: 1rem 1.15rem;
        margin-bottom: 1.5rem;
        border-left: 4px solid #486577;
        border-radius: .5rem;
        background: #edf3f6;
        color: #223f51;
    }

    .balsa-aviso p {
        margin: .35rem 0 0;
    }

    .balsa-lectura {
        max-width: 70ch;
        margin-inline: auto;
    }

    .balsa-bloque {
        padding: 1.1rem 1.2rem;
        margin-bottom: .85rem;
        background: #f7f9fb;
        border: 1px solid #e4eaf0;
        border-radius: .85rem;
        color: #24313d;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    .balsa-bloque p:last-child {
        margin-bottom: 0;
    }

    @media (max-width: 575px) {
        .balsa-bloque {
            padding: .9rem;
            line-height: 1.65;
        }
    }
</style>
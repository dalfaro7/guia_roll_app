<% if @driver.nil? %>
  <div class="alert alert-info">Todavía no hay choferes para consultar.</div>
<% else %>
  <%= form_with url: guide_assignments_path, method: :get, local: true, class: "row g-2 align-items-end mb-4" do %>
    <%= hidden_field_tag :report, "driver" %>
    <div class="col-md-5"><%= label_tag :driver_id, "Chofer", class: "form-label" %><%= select_tag :driver_id, options_from_collection_for_select(@drivers, :id, :name, @driver.id), class: "form-select" %></div>
    <div class="col-md-4"><%= label_tag :week, "Una fecha de la semana", class: "form-label" %><%= date_field_tag :week, @week_start.iso8601, max: @today.iso8601, class: "form-control" %></div>
    <div class="col-md-3"><%= submit_tag "Consultar semana", class: "btn btn-primary w-100" %></div>
  <% end %>
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h2 class="h4 mb-1"><%= @driver.name %></h2><p class="mb-0">Del <%= @week_start.strftime("%d/%m/%Y") %> al <%= @report_end.strftime("%d/%m/%Y") %></p><small class="text-muted"><%= @week_open ? "Semana en curso · hasta hoy" : (@driver_settlement&.paid? ? "Pagado" : (@driver_settlement&.closed_at ? "Cerrado, pendiente de pago" : "Sin cierre contable registrado")) %></small></div>
    <div class="d-flex gap-2 flex-wrap"><button type="button" class="btn btn-primary" data-controller="weekly-print" data-action="click->weekly-print#print">Imprimir en rollo</button><%= link_to "Semana anterior", guide_assignments_path(report: "driver", driver_id: @driver.id, week: (@week_start - 7.days).iso8601), class: "btn btn-outline-secondary" %><% if @week_start < @current_week_start %><%= link_to "Semana siguiente", guide_assignments_path(report: "driver", driver_id: @driver.id, week: (@week_start + 7.days).iso8601), class: "btn btn-outline-secondary" %><% end %></div>
  </div>
  <p class="weekly-report-explainer">Pagos directos al chofer seleccionado. La tarifa de transporte de su empresa se muestra en el reporte por empresa.</p>
  <div class="table-responsive"><table id="driver-weekly-table" class="table table-striped table-hover align-middle"><thead><tr><th>Día</th><th>Actividad</th><th class="text-end">Pago del día</th></tr></thead><tbody>
    <% @driver_days.each do |day| %><tr><td><%= l(day[:date], format: "%A %d/%m") %></td><td><% day[:payments].each do |payment| %><div><%= payment[:concept] %> · <%= usd(payment[:amount_cents]) %></div><% end %><% day[:buses].each do |bus_assignment| %><div class="small text-muted"><%= bus_assignment.location %> · <%= bus_assignment.bus.alias %></div><% end %><% if day[:payments].empty? && day[:buses].empty? %>—<% end %></td><td class="text-end fw-semibold"><%= usd(day[:total_cents]) %></td></tr><% end %>
  </tbody><tfoot><% if @driver_adjustments.any? %><tr><th colspan="2">Ajustes de períodos anteriores</th><th class="text-end"><%= usd(@driver_adjustments.sum { |payment| payment[:amount_cents] }) %></th></tr><% end %><tr><th colspan="2"><%= @week_open ? "Total hasta hoy" : "Total semanal" %></th><th class="text-end"><%= usd(@selected_driver_total_cents) %></th></tr></tfoot></table></div>
  <%= render "driver_roll_receipt" %>
<% end %>

<section id="weekly-roll-receipt" aria-label="Comprobante semanal de <%= @company.name %>">
  <header class="roll-receipt__header"><h2>Transporte semanal</h2><strong class="roll-receipt__guide"><%= @company.name %></strong><div>Del <%= @week_start.strftime("%d/%m/%Y") %> al <%= @report_end.strftime("%d/%m/%Y") %></div><div><%= @week_open ? "Semana en curso · hasta hoy" : "Semana completa" %></div></header>
  <% @company_days.each do |day| %><article class="roll-receipt__day"><div class="roll-receipt__row roll-receipt__day-heading"><strong><%= l(day[:date], format: "%A %d/%m") %></strong><strong><%= usd(day[:total_cents]) %></strong></div><% day[:buses].each do |bus_assignment| %><div class="roll-receipt__row roll-receipt__line"><span><%= bus_assignment.location %> · <%= bus_assignment.bus.alias %><% if bus_assignment.driver %> · <%= bus_assignment.driver.name %><% end %></span><span><%= usd(bus_assignment.cost_cents) %></span></div><% end %><% if day[:buses].empty? %><div>Sin vehículos asignados</div><% end %></article><% end %>
  <footer class="roll-receipt__row roll-receipt__total"><strong><%= @week_open ? "Total hasta hoy" : "Total semanal" %></strong><strong><%= usd(@selected_company_total_cents) %></strong></footer><% if @week_open %><p class="roll-receipt__note">Los costos de hoy pueden cambiar al cierre.</p><% end %>
</section>

<% content_for :head do %>
  <%= stylesheet_link_tag "weekly_roll_receipt", "data-turbo-track": "reload" %>
<% end %>

<div id="weekly-report-page" class="container-fluid py-4">
  <div class="weekly-report-layout">
    <aside class="weekly-report-sidebar" aria-label="Tipos de reporte">
      <p class="weekly-report-sidebar__label">REPORTES SEMANALES</p>
      <nav class="weekly-report-nav" aria-label="Seleccionar reporte">
        <% [["guide", "Reporte por Guía"], ["driver", "Reporte por Chofer"], ["company", "Reporte por Empresa"], ["general", "Reporte General"]].each do |type, label| %>
          <%= link_to label, weekly_report_tab_path(type), class: "weekly-report-nav__link #{'is-active' if @report_type == type}", aria: { current: (@report_type == type ? "page" : nil) } %>
        <% end %>
      </nav>
      <p class="weekly-report-sidebar__hint">Semana de miércoles a martes. Puedes consultar semanas anteriores en cada reporte.</p>
    </aside>

    <main class="weekly-report-main">
      <header class="weekly-report-heading">
        <h1>Reportes semanales</h1>
        <p class="text-muted mb-0"><%= @week_open ? "Semana en curso: se muestran los días transcurridos hasta hoy." : "Última semana cerrada por defecto, de miércoles a martes." %></p>
      </header>
      <% case @report_type %>
      <% when "driver" %>
        <%= render "driver_report" %>
      <% when "company" %>
        <%= render "company_report" %>
      <% when "general" %>
        <%= render "general_report" %>
      <% else %>
        <%= render "guide_report" %>
      <% end %>
    </main>
  </div>
</div>

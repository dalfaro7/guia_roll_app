<div class="container">

    <h3>Consulta de asignaciones de guías</h3>

    <hr>

    <h3>Asignación del día</h3>

    <%= form_with url: guide_assignments_path, method: :get, local: true do %>

    <div class="row">

        <div class="col-md-4">
            <label>Guía</label>
            <%= select_tag :guide_id,
options_from_collection_for_select(@guides, :id, :name, params[:guide_id]),
class: "form-control" %>
        </div>

        <div class="col-md-4">
            <label>Fecha</label>
            <%= date_field_tag :date, params[:date], class: "form-control" %>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <%= submit_tag "Consultar día", class: "btn btn-primary w-100" %>
        </div>

    </div>

    <% end %>

    <br>

    <% if @daily_assignment %>

    <div class="card p-3">

        <strong>Guía:</strong> <%= @daily_assignment.guide.name %><br>
        <strong>Estado:</strong> <%= roll_status_label(@daily_assignment.status) %><br>
        <strong>Ubicación:</strong> <%= @daily_assignment.location || "-" %><br>
        <strong>Rol principal:</strong> <%= roll_role_label(@daily_assignment.role_primary) %><br>
        <strong>Rol secundario:</strong> <%= roll_role_label(@daily_assignment.role_secondary) %>

    </div>

    <% end %>

    <hr>

    <h3>Asignaciones por rango de fechas</h3>

    <%= form_with url: guide_assignments_path, method: :get, local: true do %>
    <div class="row">
        <div class="col-md-3">
            <%= label_tag :range_guide_id, "Guía" %>
            <%= select_tag :range_guide_id,
                options_from_collection_for_select(@guides, :id, :name, params[:range_guide_id]),
                class: "form-control" %>
        </div>

        <div class="col-md-3">
            <%= label_tag :start_date, "Fecha inicial" %>
            <%= date_field_tag :start_date, params[:start_date], class: "form-control", required: true %>
        </div>

        <div class="col-md-3">
            <%= label_tag :end_date, "Fecha final" %>
            <%= date_field_tag :end_date, params[:end_date], class: "form-control", required: true %>
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <%= submit_tag "Ver período", class: "btn btn-success w-100" %>
        </div>
    </div>
    <% end %>

    <br>

    <% if @range_error.present? %>
    <div class="alert alert-warning"><%= @range_error %></div>
    <% elsif @range %>
    <p>Asignaciones desde <%= @range.first %> hasta <%= @range.last %>.</p>

    <% if @range_assignments.any? %>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Ubicación</th>
                <th>Rol principal</th>
                <th>Rol secundario</th>
            </tr>
        </thead>
        <tbody>
            <% @range_assignments.each do |gd| %>
            <tr>
                <td><%= gd.work_day.date %></td>
                <td><%= roll_status_label(gd.status) %></td>
                <td><%= gd.location || "-" %></td>
                <td><%= roll_role_label(gd.role_primary) %></td>
                <td><%= roll_role_label(gd.role_secondary) %></td>
            </tr>
            <% end %>
        </tbody>
    </table>
    <% else %>
    <p>No hay asignaciones en este período.</p>
    <% end %>
    <% end %>

</div>
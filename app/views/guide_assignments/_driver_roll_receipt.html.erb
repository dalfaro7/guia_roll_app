<section id="weekly-roll-receipt" aria-label="Comprobante semanal de <%= @driver.name %>">
  <header class="roll-receipt__header"><h2>Pago semanal · chofer</h2><strong class="roll-receipt__guide"><%= @driver.name %></strong><div>Del <%= @week_start.strftime("%d/%m/%Y") %> al <%= @report_end.strftime("%d/%m/%Y") %></div><div><%= @week_open ? "Semana en curso · hasta hoy" : (@driver_settlement&.paid? ? "Pagado" : (@driver_settlement&.closed_at ? "Cerrado, pendiente de pago" : "Sin cierre contable registrado")) %></div></header>
  <% @driver_days.each do |day| %><article class="roll-receipt__day"><div class="roll-receipt__row roll-receipt__day-heading"><strong><%= l(day[:date], format: "%A %d/%m") %></strong><strong><%= usd(day[:total_cents]) %></strong></div><% day[:payments].each do |payment| %><div class="roll-receipt__row roll-receipt__line"><span><%= payment[:concept] %></span><span><%= usd(payment[:amount_cents]) %></span></div><% end %><% day[:buses].each do |bus_assignment| %><div class="roll-receipt__assignment"><%= bus_assignment.location %> · <%= bus_assignment.bus.alias %></div><% end %><% if day[:payments].empty? && day[:buses].empty? %><div>Sin asignación</div><% end %></article><% end %>
  <% @driver_adjustments.each do |payment| %><div class="roll-receipt__row roll-receipt__adjustment"><span><%= payment[:concept] %></span><strong><%= usd(payment[:amount_cents]) %></strong></div><% end %>
  <footer class="roll-receipt__row roll-receipt__total"><strong><%= @week_open ? "Total hasta hoy" : "Total semanal" %></strong><strong><%= usd(@selected_driver_total_cents) %></strong></footer><% if @week_open %><p class="roll-receipt__note">Los importes planificados de hoy son provisionales.</p><% end %>
</section>

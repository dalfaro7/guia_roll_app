<div class="container mt-4">
    <h1>Acumulados de oficina</h1>

    <%= render "shared/office_menu" %>

    <div class="mb-3">
        <%= form_with url: office_day_credits_path, method: :get, local: true do %>
        <%= month_field_tag :month, @month.strftime("%Y-%m"),
          class: "form-control d-inline-block",
          style: "width: 220px;" %>

        <%= submit_tag "Ver mes", class: "btn btn-secondary" %>
        <% end %>
    </div>

    <div class="mb-3">
        <%= button_to "Generar acumulados por feriados del mes",
        generate_for_month_office_day_credits_path(month: @month.strftime("%Y-%m")),
        method: :post,
        class: "btn btn-primary" %>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Oficinista</th>
                <th>Acumulados disponibles</th>
                <th>Acumulados usados</th>
            </tr>
        </thead>

        <tbody>
            <% @employees.each do |employee| %>
            <tr>
                <td><%= employee.name %></td>
                <td><%= employee.office_day_credits.where(used: false).count %></td>
                <td><%= employee.office_day_credits.where(used: true).count %></td>
            </tr>
            <% end %>
        </tbody>
    </table>

    <h3 class="mt-4">Detalle de acumulados</h3>

    <table class="table table-bordered table-sm">
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Fecha</th>
                <th>Origen</th>
                <th>Estado</th>
                <th>Observación</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            <% @credits.each do |credit| %>
            <tr>

                <td>
                    <%= credit.office_employee.name %>
                </td>

                <td>
                    <%= credit.date %>
                </td>

                <td>
                    <%= credit.source == "legacy" ? "Histórico" : "Feriado trabajado" %>
                </td>

                <td>
                    <%= credit.used? ? "Usado" : "Disponible" %>
                </td>

                <td>
                    <%= credit.notes.presence || "-" %>
                </td>

                <td>
                    <% unless credit.used? %>
                    <%= button_to "Eliminar",
                        office_day_credit_path(credit),
                        method: :delete,
                        class: "btn btn-sm btn-danger",
                        data: {
                            turbo_confirm: "¿Eliminar este acumulado?"
                        } %>
                    <% end %>
                </td>

            </tr>
            <% end %>
        </tbody>
    </table>

    <%= link_to "Agregar acumulados históricos",
    new_office_day_credit_path,
    class: "btn btn-success mb-3" %>
</div>
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Roll Notes</h2>
            <p class="text-muted mb-0">
                Incidents and operational observations
            </p>
        </div>

        <%= link_to "Back to Rolls",
                work_days_path,
                class: "btn btn-outline-secondary" %>
    </div>


    <!-- DATE FILTER -->

    <div class="card mb-4">
        <div class="card-body">

            <%= form_with url: roll_notes_path,
                    method: :get,
                    local: true do %>

            <div class="row align-items-end">

                <div class="col-md-4">
                    <label class="form-label">
                        Roll Date
                    </label>

                    <%= date_field_tag :date,
                               @selected_date,
                               class: "form-control" %>
                </div>

                <div class="col-md-2">
                    <%= submit_tag "Load Roll",
                           class: "btn btn-primary w-100" %>
                </div>

            </div>

            <% end %>

        </div>
    </div>


    <% if @work_day.present? %>

    <!-- SELECTED ROLL -->

    <div class="alert alert-success">
        Published roll:
        <strong>
            <%= @work_day.date.strftime("%B %d, %Y") %>
        </strong>
    </div>


    <!-- NEW NOTE -->

    <div class="card mb-4">

        <div class="card-header">
            <strong>Add Note</strong>
        </div>

        <div class="card-body">

            <%= form_with url: roll_notes_path,
                      method: :post,
                      local: true do %>

            <%= hidden_field_tag :work_day_id,
                               @work_day.id %>


            <div class="mb-3">

                <label class="form-label">
                    Type
                </label>

                <%= select_tag "roll_note[note_type]",
                  options_for_select([
                    ["Incident", "incident"],
                    ["Observation", "observation"]
                  ]),
                  class: "form-select" %>

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Guides involved
                </label>

                <div class="row">

                    <% @guide_days.each do |guide_day| %>

                    <div class="col-md-4 mb-2">

                        <div class="form-check">

                            <%= check_box_tag "guide_day_ids[]",
                                      guide_day.id,
                                      false,
                                      id: "guide_day_#{guide_day.id}",
                                      class: "form-check-input" %>

                            <%= label_tag "guide_day_#{guide_day.id}",
                                  guide_day.guide.name,
                                  class: "form-check-label" %>

                            <% if guide_day.location.present? %>
                            <small class="text-muted">
                                —
                                <%= guide_day.location %>
                            </small>
                            <% end %>

                        </div>

                    </div>

                    <% end %>

                </div>

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Note
                </label>

                <%= text_area_tag "roll_note[note]",
                              nil,
                              rows: 5,
                              class: "form-control",
                              required: true %>

            </div>


            <%= submit_tag "Save Note",
                         class: "btn btn-danger" %>

            <% end %>

        </div>
    </div>


    <!-- EXISTING NOTES -->

    <h4 class="mb-3">
        Notes for this Roll
    </h4>

    <% if @roll_notes.any? %>

    <% @roll_notes.each do |roll_note| %>

    <div class="card mb-3">

        <div class="card-body">

            <div class="d-flex justify-content-between">

                <div>

                    <% if roll_note.incident? %>

                    <span class="badge bg-danger">
                        Incident
                    </span>

                    <% else %>

                    <span class="badge bg-info text-dark">
                        Observation
                    </span>

                    <% end %>

                </div>

                <small class="text-muted">
                    <%= roll_note.created_at.strftime("%d/%m/%Y %H:%M") %>
                </small>

            </div>


            <p class="mt-3 mb-2">
                <%= simple_format(roll_note.note) %>
            </p>


            <% if roll_note.guide_days.any? %>

            <div class="mb-2">

                <strong>Guides:</strong>

                <%= roll_note.guide_days
                             .map { |gd| gd.guide.name }
                             .join(", ") %>

            </div>

            <% end %>


            <small class="text-muted">
                Created by:
                <%= roll_note.created_by.name %>
            </small>


            <div class="mt-3">

                <%= button_to "Delete",
                    roll_note_path(roll_note),
                    method: :delete,
                    data: {
                      turbo_confirm: "Delete this roll note?"
                    },
                    class: "btn btn-sm btn-outline-danger" %>

            </div>

        </div>
    </div>

    <% end %>

    <% else %>

    <div class="alert alert-light border">
        No notes have been registered for this roll.
    </div>

    <% end %>


    <% else %>

    <div class="alert alert-warning">
        There is no published roll for
        <strong><%= @selected_date.strftime("%d/%m/%Y") %></strong>.
    </div>

    <% end %>

</div>
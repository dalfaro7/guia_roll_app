<% content_for :title, 'Panel de equidad · Roll de Guías' %>
<% content_for :head do %><link rel="stylesheet" href="/equity-dashboard.css?v=2"><script src="/equity-dashboard.js?v=2" defer></script><% end %>
<% months = %w[Enero Febrero Marzo Abril Mayo Junio Julio Agosto Septiembre Octubre Noviembre Diciembre] %>
<div class="equity-dashboard">
  <header class="equity-hero">
    <div><span class="equity-eyebrow">DISTRIBUCIÓN DEL TRABAJO</span><h1>Panel de equidad</h1><p>Revisa las asignaciones y la participación de cada guía.</p></div>
    <%= form_with url: dashboard_path, method: :get, local: true, class: 'equity-month-filter' do %>
      <%= hidden_field_tag :special_role, @selected_special_role, id: nil %><%= hidden_field_tag :guide_id, @selected_guide&.id, id: nil %><%= hidden_field_tag :incident_year, @incident_year, id: nil %><%= hidden_field_tag :incident_month, @incident_month, id: nil %>
      <div><%= label_tag :month, 'Mes de asignaciones' %><%= month_field_tag :month, @month.strftime('%Y-%m'), class: 'form-control' %></div><%= submit_tag 'Actualizar', class: 'btn btn-primary' %>
    <% end %>
  </header>
  <nav class="equity-nav" aria-label="Secciones del panel"><a href="#equity-summary">Resumen</a><a href="#equity-guides">Detalle por guía</a><a href="#equity-roles">Roles especiales</a><a href="#equity-incidents">Incidentes</a></nav>
  <section id="equity-summary" aria-label="Resumen mensual">
    <div class="equity-period"><h2><%= months[@month.month - 1] %> <%= @month.year %></h2><span><%= @guides.size %> guías activos</span></div>
    <div class="equity-kpis">
      <article><span>Días con asignación</span><strong><%= @worked_month_days %></strong><small>Fechas con al menos una asignación</small></article>
      <article><span>Puestos asignados</span><strong><%= @assigned_work_slots %></strong><small>Asignaciones de los guías activos</small></article>
      <article><span>Promedio por guía</span><strong><%= @average.to_f.round(2) %></strong><small>Puestos asignados ÷ guías activos</small></article>
    </div>
    <article class="equity-panel"><header><div><h2>Distribución de asignaciones</h2><p>Compara los puestos asignados a cada guía durante el mes.</p></div></header>
      <% if @assigned_work_slots.positive? %><%= column_chart @chart_data, height: '320px', colors: ['#17785f'], library: {plugins: {legend: {display: false}}} %><% else %><p class="equity-empty">No hay asignaciones registradas para este mes.</p><% end %>
    </article>
  </section>
  <section id="equity-guides" class="equity-panel" aria-labelledby="equity-guides-title">
    <header><div><h2 id="equity-guides-title">Detalle por guía</h2><p>La participación y la diferencia usan el total de días trabajados más tareas asignadas.</p></div></header>
    <div class="equity-guide-controls" hidden data-equity-controls>
      <div><label for="equity-guide-search">Buscar guía</label><input type="search" id="equity-guide-search" placeholder="Nombre o apellido…" autocomplete="off"></div>
      <div><label for="equity-guide-priority">Nivel de prioridad</label><select id="equity-guide-priority"><option value="">Todos los niveles</option><% @guides.map(&:priority).uniq.sort.each do |priority| %><option value="<%= priority %>">Nivel <%= priority %></option><% end %></select></div>
      <div><label for="equity-guide-page-size">Guías por página</label><select id="equity-guide-page-size"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="all">Todos</option></select></div>
    </div>
    <div class="equity-legend"><span class="equity-badge above">Más de 1 sobre el promedio</span><span class="equity-badge balanced">Entre −1 y +1</span><span class="equity-badge below">Más de 1 bajo el promedio</span></div>
    <div class="equity-table-scroll" tabindex="0" role="region" aria-label="Asignaciones por guía">
    <table class="equity-table"><thead><tr><th scope="col">Guía</th><th scope="col">Días trabajados</th><th scope="col">Asignaciones (tareas)</th><th scope="col">Participación</th><th scope="col">Diferencia vs. promedio</th><th scope="col">Días libres</th><th scope="col">Días penalizados</th><th scope="col">Días fuera del roll</th></tr></thead><tbody>
    <% @dashboard_data.each do |data| %><% deviation = data[:deviation].to_f; band = deviation > 1 ? 'above' : deviation < -1 ? 'below' : 'balanced' %>
      <tr data-equity-guide="<%= data[:guide].name %>" data-equity-priority="<%= data[:guide].priority %>"><th scope="row"><%= data[:guide].name %></th><td><strong><%= data[:worked_days] %></strong></td><td><strong><%= data[:assigned_tasks] %></strong></td><td><%= data[:percentage] %>%</td><td><span class="equity-badge <%= band %>"><%= '+' if deviation > 0 %><%= data[:deviation] %></span></td><td><%= data[:days_off] %></td><td><%= data[:penalized_days] %></td><td><%= data[:outside_roll][:count] %><%= " (parcial)" unless data[:outside_roll][:complete] %></td></tr>
    <% end %>
    <% if @dashboard_data.empty? %><tr><td colspan="8" class="equity-empty">No hay guías activos para mostrar.</td></tr><% end %>
    </tbody></table></div><p class="equity-empty" data-equity-no-results hidden>No hay guías para los filtros seleccionados.</p>
    <div class="equity-guide-pagination" hidden data-equity-pagination><p class="equity-table-note" data-equity-count aria-live="polite"><%= @dashboard_data.size %> guías</p><div><button type="button" data-equity-prev disabled>Anterior</button><span data-equity-page aria-live="polite"></span><button type="button" data-equity-next disabled>Siguiente</button></div></div>
    <p class="equity-footnote">Fuera del roll suma vacaciones y fechas desactivado, sin duplicarlas y hasta hoy. «Parcial» indica que falta historial de activación anterior. Asignaciones cuenta únicamente tareas asignadas; Días trabajados cuenta únicamente el estado trabajado. La diferencia es informativa; no modifica el orden del roll.</p>
  </section>
  <section id="equity-roles" class="equity-panel" aria-labelledby="equity-roles-title">
    <header><div><h2 id="equity-roles-title">Roles especiales</h2><p>Asignaciones de seguridad, fotografía y guía de bus en el mes seleccionado.</p></div></header>
    <%= form_with url: dashboard_path(anchor: 'equity-roles'), method: :get, local: true, class: 'equity-filter-row' do %>
      <%= hidden_field_tag :month, @month.strftime('%Y-%m') %><%= hidden_field_tag :guide_id, @selected_guide&.id, id: nil %><%= hidden_field_tag :incident_year, @incident_year, id: nil %><%= hidden_field_tag :incident_month, @incident_month, id: nil %>
      <div><%= label_tag :special_role, 'Mostrar guías con el rol' %><%= select_tag :special_role, options_for_select([['Todos los roles','all'],['Kayakista de seguridad','safety_kayaker'],['Fotógrafo','photographer'],['Guía de bus','bus_guide']], @selected_special_role), class: 'form-select' %></div><%= submit_tag 'Aplicar filtro', class: 'btn btn-primary' %>
    <% end %>
    <% if @filtered_special_role_data.any? %>
      <%= column_chart [{name: 'Kayakista de seguridad', data: @special_role_chart_data.map { |d| [d[:name], d[:'Safety Kayaker'].to_i] }}, {name: 'Fotógrafo', data: @special_role_chart_data.map { |d| [d[:name], d[:Photographer].to_i] }}, {name: 'Guía de bus', data: @special_role_chart_data.map { |d| [d[:name], d[:'Bus Guide'].to_i] }}], height: '320px', stacked: true, colors: ['#17785f','#3579b5','#b7791f'] %>
      <div class="equity-table-scroll" tabindex="0" role="region" aria-label="Roles especiales por guía"><table class="equity-table"><thead><tr><th scope="col">Guía</th><th scope="col">Kayakista de seguridad</th><th scope="col">Fotógrafo</th><th scope="col">Guía de bus</th><th scope="col">Total</th></tr></thead><tbody>
      <% @filtered_special_role_data.each do |data| %><tr><th scope="row"><%= data[:guide_name] %></th><td><%= data[:safety_kayaker] %></td><td><%= data[:photographer] %></td><td><%= data[:bus_guide] %></td><td><strong><%= data[:total] %></strong></td></tr><% end %>
      </tbody></table></div>
    <% else %><p class="equity-empty">No hay asignaciones de roles especiales para este filtro.</p><% end %>
  </section>
  <section id="equity-incidents" class="equity-panel" aria-labelledby="equity-incidents-title">
    <header><div><span class="equity-eyebrow">SEGUIMIENTO OPERATIVO</span><h2 id="equity-incidents-title">Incidentes</h2><p>Este período se filtra por separado y no afecta las métricas de equidad.</p></div></header>
    <%= form_with url: dashboard_path(anchor: 'equity-incidents'), method: :get, local: true, class: 'equity-filter-row' do %>
      <%= hidden_field_tag :month, @month.strftime('%Y-%m') %><%= hidden_field_tag :special_role, @selected_special_role, id: nil %><%= hidden_field_tag :guide_id, @selected_guide&.id, id: nil %>
      <div><%= label_tag :incident_year, 'Año de incidentes' %><%= select_tag :incident_year, options_for_select(@incident_years, @incident_year), class: 'form-select' %></div><div><%= label_tag :incident_month, 'Mes de incidentes' %><%= select_tag :incident_month, options_for_select([['Todo el año','']] + months.each_with_index.map { |name,i| [name,i+1] }, @incident_month), class: 'form-select' %></div><%= submit_tag 'Filtrar incidentes', class: 'btn btn-primary' %>
    <% end %>
    <div class="equity-incident-summary"><span><strong><%= @incidents_by_guide.size %></strong> guías con incidentes en el período</span><span><strong><%= @incidents_by_month.sum { |_, count| count.to_i } %></strong> incidentes en todo <%= @incident_year %></span></div>
    <div class="equity-chart-grid"><article><h3>Por guía · <%= @incident_month.present? && @incident_month.between?(1,12) ? months[@incident_month-1] : 'Todo el año' %> <%= @incident_year %></h3>
      <% if @incidents_by_guide.any? %><%= bar_chart @incidents_by_guide, height: '320px', colors: ['#b7791f'], discrete: true %><% else %><p class="equity-empty">No hay incidentes registrados para este período.</p><% end %>
      </article><article><h3>Por mes · <%= @incident_year %></h3><p class="equity-footnote">Siempre muestra el año completo.</p><%= column_chart @incidents_by_month, height: '320px', colors: ['#3579b5'], discrete: true %></article></div>
    <p class="equity-footnote">Un incidente con varios guías cuenta para cada guía involucrado, pero una sola vez en el total anual.</p>
  </section>
</div>

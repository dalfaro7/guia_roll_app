<div class="container">
    <h2>Buses</h2>

    <%= link_to "Nuevo bus", new_bus_path %>

    <table border="1">
        <thead>
            <tr>
                <th>Alias</th>
                <th>Empresa</th>
                <th>Placa</th>
                <th>Capacidad</th>
                <th>Teléfono</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            <% @buses.each do |bus| %>
            <tr>
                <td><%= bus.alias %></td>
                <td><%= bus.company %></td>
                <td><%= bus.plate %></td>
                <td><%= bus.capacity %></td>
                <td><%= bus.phone %></td>
                <td>
                    <%= link_to "Editar", edit_bus_path(bus) %>
                    <%= link_to "Eliminar", bus_path(bus), method: :delete, data: { confirm: "¿Eliminar este bus?" } %>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table>
</div>
<%= form_with model: @bus, local: true do |f| %>
  <% if @bus.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <p class="fw-semibold mb-2">Revisa los datos del bus:</p>
      <ul class="mb-0"><% @bus.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <%= f.label :alias, "Nombre o alias", class: "form-label fw-semibold" %>
      <%= f.text_field :alias, class: "form-control", required: true, autofocus: true, placeholder: "Ej. Bus principal" %>
      <div class="form-text">Así aparecerá en la programación.</div>
    </div>
    <div class="col-12 col-md-6">
      <%= f.label :plate, "Placa", class: "form-label fw-semibold" %>
      <%= f.text_field :plate, class: "form-control", required: true, placeholder: "Ej. ABC-123" %>
    </div>
    <div class="col-12 col-md-6">
      <%= f.label :transport_company_id, "Empresa", class: "form-label fw-semibold" %>
      <%= f.collection_select :transport_company_id, @companies, :id, :name, { prompt: "Seleccionar empresa" }, class: "form-select", required: true %>
      <div class="form-text">Al cambiar la empresa, los viajes de hoy y anteriores conservan su empresa y costo. Los viajes de fechas futuras toman la nueva tarifa. <% if current_user.admin? %><%= link_to "Administrar empresas", transport_companies_path %><% end %></div>
    </div>
    <div class="col-12 col-md-6">
      <%= f.label :capacity, "Capacidad de pasajeros", class: "form-label fw-semibold" %>
      <%= f.number_field :capacity, class: "form-control", required: true, min: 1, step: 1, inputmode: "numeric" %>
      <div class="form-text">Pequeño: hasta 15 pasajeros. Grande: desde 20. Se asigna automáticamente.</div>
    </div>
    <div class="col-12 col-md-6">
      <%= f.label :vehicle_kind, "Tipo de vehículo", class: "form-label fw-semibold" %>
      <%= f.select :vehicle_kind, [["Bus", "bus"], ["4x4", "four_by_four"]], {}, class: "form-select", required: true %>
    </div>
    <div class="col-12">
      <%= f.label :phone, "Teléfono histórico del bus (opcional)", class: "form-label fw-semibold" %>
      <%= f.telephone_field :phone, class: "form-control", autocomplete: "tel", placeholder: "Ej. +506 8888 8888" %>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mt-4">
    <%= f.submit @bus.persisted? ? "Guardar cambios" : "Crear bus", class: "btn btn-primary" %>
    <%= link_to "Cancelar", @bus.persisted? ? bus_path(@bus) : buses_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

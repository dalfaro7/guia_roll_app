<h1>Mi cuenta</h1><p><%= @account.name %> · <%= @account.phone %></p><% if @error %><p role="alert"><%= @error %></p><% end %><%= form_with url:kayaktalkie_profile_path,method: :patch do |f| %><%= f.label :email,'Correo de recuperación (opcional)' %><%= f.email_field :email,value:@account.email,autocomplete:'email' %><%= f.label :current_password,'Contraseña actual' %><%= f.password_field :current_password,required:true,autocomplete:'current-password' %><%= f.label :password,'Nueva contraseña (dejar vacía para conservar)' %><%= f.password_field :password,minlength:12,autocomplete:'new-password' %><%= f.label :password_confirmation,'Confirmar nueva contraseña' %><%= f.password_field :password_confirmation,minlength:12,autocomplete:'new-password' %><%= f.submit 'Guardar cambios' %><% end %><%= link_to 'Volver',@account.map_access? ? tracking_path : kayaktalkie_path %>

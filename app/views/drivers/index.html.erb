<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div><p class="text-uppercase text-muted small mb-1">Transporte</p><h1>Choferes</h1></div>
    <%= link_to "Empresas de transporte", transport_companies_path, class: "btn btn-outline-primary" %>
  </div>
  <p>El chofer se elige en cada salida. Los freelance pueden conducir vehículos de distintas empresas; la empresa externa paga directamente a sus propios choferes.</p>
  <% payment_options = [["Sin pago directo", "none"], ["Por viaje", "per_trip"],
    ["Jefe de choferes (diario)", "daily_hg"],
    ["Ida y vuelta", "round_trip"]] %>
  <% @drivers.each do |driver| %>
    <div class="card mb-2"><div class="card-body">
      <%= form_with model: driver, class: "row g-2 align-items-end" do |f| %>
        <div class="col-md-3"><%= f.label :name, "Nombre", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
        <div class="col-md-2"><%= f.label :transport_company_id, "Empresa", class: "form-label" %><%= f.collection_select :transport_company_id, @companies, :id, :name, { include_blank: "Freelance" }, class: "form-select" %></div>
        <div class="col-md-2"><%= f.label :payment_mode, "Pago ARC", class: "form-label" %><%= f.select :payment_mode, payment_options, {}, class: "form-select" %></div>
        <div class="col-md-2"><%= f.label :phone, "Teléfono", class: "form-label" %><%= f.telephone_field :phone, class: "form-control", placeholder: "Pendiente" %></div>
        <div class="col-md-1"><%= f.label :active, "Activo", class: "form-label" %><%= f.check_box :active, class: "form-check-input d-block" %></div>
        <div class="col-md-2"><%= f.submit "Guardar", class: "btn btn-outline-primary w-100" %></div>
      <% end %>
    </div>
    <div class="card-footer bg-light py-3">
      <%= button_to "Eliminar chofer", driver_path(driver), method: :delete,
        class: "btn btn-sm btn-outline-danger",
        form: { data: { turbo_confirm: "¿Estás seguro de eliminar a #{driver.name}? Esta acción no se puede deshacer. Si tiene viajes o pagos registrados, no se eliminará." } } %>
    </div>
    </div>
  <% end %>
  <div class="card mt-4"><div class="card-body"><h2 class="h5">Nuevo chofer</h2>
    <%= form_with model: Driver.new, class: "row g-2 align-items-end" do |f| %>
      <div class="col-md-3"><%= f.label :name, "Nombre", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
      <div class="col-md-2"><%= f.label :transport_company_id, "Empresa", class: "form-label" %><%= f.collection_select :transport_company_id, @companies, :id, :name, { include_blank: "Freelance" }, class: "form-select" %></div>
      <div class="col-md-2"><%= f.label :payment_mode, "Pago ARC", class: "form-label" %><%= f.select :payment_mode, payment_options, {}, class: "form-select" %></div>
      <div class="col-md-2"><%= f.label :phone, "Teléfono", class: "form-label" %><%= f.telephone_field :phone, class: "form-control", placeholder: "Pendiente" %></div>
      <div class="col-md-3"><%= f.submit "Agregar chofer", class: "btn btn-primary w-100" %></div>
    <% end %>
  </div></div>
</main>
